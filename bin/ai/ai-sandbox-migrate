#!/usr/bin/env bash
# Bring ~/.ai-sandbox up to the current schema. Idempotent, silent when there
# is nothing to do, and safe to run before every sandbox start.
#
# Nothing here deletes user data. Directories MOVE; there is no
# copy-then-delete anywhere in this file.
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ai-sandbox-lib.sh"

[ -d "$AI_SANDBOX_ROOT" ] || exit 0

say() { printf 'ai-sandbox: %s\n' "$*"; }

# --- Refresh installed helpers from the recorded source tree ---------------
if [ -f "$AI_SANDBOX_ROOT/config" ]; then
    # shellcheck disable=SC1091
    . "$AI_SANDBOX_ROOT/config"
    if [ -n "${DEV_TOOLS_DIR:-}" ] && [ -d "$DEV_TOOLS_DIR/bin/ai" ]; then
        # The source tree's lib knows about helpers this installed copy may
        # predate, so take the list from there.
        # shellcheck disable=SC1091
        . "$DEV_TOOLS_DIR/bin/ai/ai-sandbox-lib.sh"
        while IFS= read -r helper; do
            src="$DEV_TOOLS_DIR/bin/ai/$helper"
            dst="$AI_SANDBOX_ROOT/bin/$helper"
            [ -f "$src" ] || continue
            if ! cmp -s "$src" "$dst"; then
                # Install via a temp file and rename. This script refreshes
                # ITSELF here, and bash reads a script incrementally by file
                # offset: truncating the file in place under a running bash can
                # feed it the wrong bytes. A rename swaps the directory entry
                # and leaves the running process on its original inode.
                install -m 0755 "$src" "$dst.new.$$"
                mv -f "$dst.new.$$" "$dst"
            fi
        done < <(ai_sandbox_helpers)
        chmod 0644 "$AI_SANDBOX_ROOT/bin/ai-sandbox-lib.sh" 2>/dev/null || true
    fi
fi

# .schema-version records the layout the last clean run left behind; a refused
# or skipped sandbox keeps it unwritten so the state on disk is never
# overstated. A store already at a NEWER schema than this script knows was
# written by a newer dev-tools checkout, and the M-steps below would
# reinterpret its layout with stale rules -- so refuse rather than guess.
recorded=$(cat "$AI_SANDBOX_ROOT/.schema-version" 2>/dev/null || true)
case $recorded in ''|*[!0-9]*) recorded=0 ;; esac
if [ "$recorded" -gt "$AI_SANDBOX_SCHEMA_VERSION" ]; then
    say "$AI_SANDBOX_ROOT is at schema $recorded; this ai-sandbox-migrate only knows $AI_SANDBOX_SCHEMA_VERSION."
    say "  leaving it alone. Update dev-tools (or re-run create-ai-sandbox.sh from the newer checkout)."
    exit 0
fi
pending=0

# --- M1: rename legacy, basename-keyed sandboxes ---------------------------
# 'working_dir:' is the absolute project path; the script has always written
# it. Reading it makes the rename deterministic instead of a basename guess,
# which is what lets two same-named projects migrate correctly.
legacy_project_of() {
    # '|| true': an unreadable or otherwise unparsable compose file must be
    # reported and skipped like any other unparsable directory, not (via
    # set -e + pipefail) abort the whole run and strand every later
    # directory in the glob unmigrated.
    sed -n 's/^[[:space:]]*working_dir:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' \
        "$1" 2>/dev/null | tail -n 1 || true
}

migrated=0
for dir in "$AI_SANDBOX_ROOT"/*-agent; do
    [ -d "$dir" ] || continue
    [ -f "$dir/project-path" ] && continue          # already on the new scheme

    compose="$dir/docker-compose.yml"
    project=""
    [ -f "$compose" ] && project=$(legacy_project_of "$compose")
    if [ -z "$project" ]; then
        say "cannot determine the project for $(basename "$dir"); left unchanged."
        say "  (no readable working_dir: in $compose)"
        pending=$((pending + 1))
        continue
    fi

    target="$AI_SANDBOX_ROOT/$(ai_sandbox_project_id "$project")-agent"
    if [ "$target" = "$dir" ]; then
        printf '%s\n' "$project" > "$dir/project-path"
        continue
    fi
    if [ -e "$target" ]; then
        say "cannot migrate $(basename "$dir"): $(basename "$target") already exists."
        say "  source $dir"
        say "  target $target"
        pending=$((pending + 1))
        continue
    fi

    # Never migrate a sandbox that is currently running. Moving the directory
    # out from under a live container strands its bind mounts, and force-removing
    # the container would destroy whatever the user is doing inside it -- which,
    # for the sandbox this very script may be running in, means killing the
    # session that invoked it. Refuse, and say how to proceed.
    if ai_sandbox_container_running "$(basename "$dir")"; then
        say "cannot migrate $(basename "$dir"): its container is running."
        say "  stop it first (ai-sandbox-stop in that project), then re-run."
        pending=$((pending + 1))
        continue
    fi

    # The display number is derived from the id, so the old server must go
    # before the directory holding its stop script moves.
    [ -x "$dir/stop-display.sh" ] && "$dir/stop-display.sh" >/dev/null 2>&1 || true

    old_name=$(basename "$dir")
    mv "$dir" "$target"
    printf '%s\n' "$project" > "$target/project-path"

    # Safe to drop: every durable thing is a bind mount; the writable layer
    # holds caches and shell history only. Compose recreates it on next start.
    if command -v docker >/dev/null 2>&1; then
        docker rm -f "$old_name" >/dev/null 2>&1 || true
    fi
    rm -rf "/tmp/.X11-unix/.ai-sandbox-${old_name}" 2>/dev/null || true

    say "migrated $old_name -> $(basename "$target")  ($project)"
    migrated=$((migrated + 1))
done

[ "$migrated" -gt 0 ] && say "$migrated sandbox(es) moved to path-derived names."

# --- M2: lift shared bulk out of existing sandboxes ------------------------
# The first sandbox to migrate donates its copy; later ones are reported, not
# deleted. Rows whose third field is empty hold data that lives only in the
# container's writable layer and has no per-project copy to lift.
#
# Same rule as M1: never touch a running sandbox. These directories are its
# bind-mount sources, and moving one out from under a live container strands
# the mount. Checked once per sandbox, and only if there is something to lift.
duplicates=0
for dir in "$AI_SANDBOX_ROOT"/*-agent; do
    [ -d "$dir" ] || continue
    running=
    while IFS='|' read -r sub _ctr sb; do
        [ -n "$sub" ] && [ -n "$sb" ] || continue
        src="$dir/$sb"
        dst="$AI_SANDBOX_ROOT/shared/$sub"
        [ -d "$src" ] || continue
        [ -n "$(ls -A "$src" 2>/dev/null)" ] || continue
        if [ -z "$running" ]; then
            if ai_sandbox_container_running "$(basename "$dir")"; then running=yes; else running=no; fi
        fi
        if [ "$running" = yes ]; then
            say "cannot lift $(basename "$dir")/$sb: its container is running."
            say "  stop it first (ai-sandbox-stop in that project), then re-run."
            pending=$((pending + 1))
            continue
        fi
        mkdir -p "$(dirname "$dst")"
        if [ ! -d "$dst" ] || [ -z "$(ls -A "$dst" 2>/dev/null)" ]; then
            rmdir "$dst" 2>/dev/null || true
            mv "$src" "$dst"
            mkdir -p "$src"
            say "shared $(basename "$dir")/$sb -> shared/$sub"
        else
            duplicates=$((duplicates + 1))
            say "duplicate: $(basename "$dir")/$sb (shared/$sub is already populated)"
        fi
    done < <(ai_sandbox_shared_mounts)
done
if [ "$duplicates" -gt 0 ]; then
    say "$duplicates duplicated director(ies) can be reclaimed: run ai-sandbox-gc"
fi

# --- M3: report per-project images left over from the old scheme -----------
if command -v docker >/dev/null 2>&1; then
    legacy_images=$(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null \
                    | grep '^ai-sandbox-' || true)
    if [ -n "$legacy_images" ]; then
        say "images from the old per-project naming scheme are no longer used:"
        printf '  %s\n' $legacy_images
        say "remove them with ai-sandbox-gc"
    fi
fi

if [ "$pending" -eq 0 ]; then
    printf '%s\n' "$AI_SANDBOX_SCHEMA_VERSION" > "$AI_SANDBOX_ROOT/.schema-version"
fi
exit 0
