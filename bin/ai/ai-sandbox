#!/usr/bin/env bash
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ai-sandbox-lib.sh"

# Runs on every start so an old layout is repaired without the user having to
# know that anything changed.
"$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ai-sandbox-migrate" || true

ai_sandbox_require_ctx || exit 1

if [ "${1:-}" = "--print-context" ]; then
    printf 'dir=%s\nname=%s\nproject=%s\n' \
        "$AI_SANDBOX_DIR" "$AI_SANDBOX_NAME" "$AI_SANDBOX_PROJECT"
    exit 0
fi

# Knowledge sync before the container comes up, so the rules it reads are the
# current main and its proposals reach the remote. Never blocks the start.
if ai_knowledge_configured; then
    "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ai-knowledge" sync "$AI_SANDBOX_PROJECT" || true
fi
# Must precede 'compose up': Docker would otherwise create the display's mount
# source itself, as root, and Xephyr could no longer bind its socket.
if [ -x "$AI_SANDBOX_DIR/start-display.sh" ]; then
    "$AI_SANDBOX_DIR/start-display.sh" || exit 1
fi
if [ "$(docker container inspect -f '{{.State.Running}}' "$AI_SANDBOX_NAME" 2>/dev/null)" != "true" ]; then
    # A sandbox whose compose file predates the host's knowledge configuration
    # would mount the rules read-write, so it is refused only here, where it
    # would come up; a running container is entered whatever its stamp.
    ai_sandbox_require_current "$AI_SANDBOX_DIR" || exit 1
    ai_sandbox_check_capacity "$AI_SANDBOX_NAME" || exit 1
    if ai_sandbox_caches_enabled "$AI_SANDBOX_DIR"; then
        # D5/D2: hold the lock from before the check until 'up' has returned --
        # releasing it any earlier would let a concurrent start reset the
        # upper of a container that just came up under this one's nose. The
        # inspect above can be stale by the time the lock is free, so the
        # first thing done under it is to look again: a container found
        # running now is simply entered below, with no check, reset or 'up'.
        mkdir -p "$AI_SANDBOX_DIR/build-caches"
        exec {CACHES_LOCK_FD}>"$AI_SANDBOX_DIR/build-caches/.lock"
        flock "$CACHES_LOCK_FD"
        if ! ai_sandbox_container_running "$AI_SANDBOX_NAME"; then
            ai_sandbox_caches_check "$AI_SANDBOX_DIR" "$AI_SANDBOX_NAME" || exit 1
            ai_sandbox_caches_reset "$AI_SANDBOX_DIR"
            echo "Starting $AI_SANDBOX_NAME..."
            ai_sandbox_compose up -d || exit 1
        fi
        exec {CACHES_LOCK_FD}>&-
    else
        echo "Starting $AI_SANDBOX_NAME..."
        ai_sandbox_compose up -d || exit 1
    fi
fi

if [ "$#" -eq 0 ]; then
    ai_sandbox_compose exec "$AI_SANDBOX_NAME" bash
elif [ "$#" -eq 1 ]; then
    # A single argument is treated as a shell snippet: ai-sandbox 'cd src && make'
    ai_sandbox_compose exec "$AI_SANDBOX_NAME" bash -lc "$1"
else
    # Several arguments are a command and its arguments; quoting is preserved.
    ai_sandbox_compose exec "$AI_SANDBOX_NAME" bash -lc 'exec "$@"' ai-sandbox "$@"
fi
