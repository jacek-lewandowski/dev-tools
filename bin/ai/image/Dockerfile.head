# Generated by create-ai-sandbox.sh -- edits here are overwritten on the next run.
FROM ubuntu:22.04

# Without a UTF-8 LANG, Java reports sun.jnu.encoding=ANSI_X3.4-1968 and
# cannot open files whose names have non-ASCII characters (C.utf8 is already
# present in Ubuntu 22.04's locale -a, so no locales package is needed).
ENV DEBIAN_FRONTEND=noninteractive \
    TERM=xterm-256color \
    CI=true \
    PLAYWRIGHT_HTML_REPORT=none \
    LANG=C.UTF-8

