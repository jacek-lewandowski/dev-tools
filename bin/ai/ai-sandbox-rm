#!/usr/bin/env bash
# Removes ONE project's sandbox. Never touches shared/ or image/, which other
# projects depend on.
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ai-sandbox-lib.sh"
ai_sandbox_require_ctx || exit 1

printf 'Remove %s and all credentials in %s? [y/N] ' "$AI_SANDBOX_NAME" "$AI_SANDBOX_DIR"
read -r reply
case "$reply" in
    y|Y) ;;
    *) echo "Cancelled."; exit 1 ;;
esac
ai_sandbox_compose down -v 2>/dev/null || true
[ -x "$AI_SANDBOX_DIR/stop-display.sh" ] && "$AI_SANDBOX_DIR/stop-display.sh"
# A root-owned leftover (left by the container user's sudo inside build-caches/,
# spec assumption A4) cannot be deleted by the host user. Attempt the removal
# and report what remains instead of letting 'set -e' abort mid-way, before
# these final messages.
rm -rf "$AI_SANDBOX_DIR" 2>/dev/null || true
# Initialised before any chance of being set, so an already-exported LEFTOVER
# from the caller's environment cannot make a clean removal exit non-zero.
LEFTOVER=""
if [ -e "$AI_SANDBOX_DIR" ]; then
    echo "Could not fully remove $AI_SANDBOX_DIR; left behind:"
    # Capped: a leftover can be thousands of root-owned files deep inside one
    # directory tree, and the 'sudo rm -rf' line must never scroll off under
    # that. '|| true' on each: 'find' exits non-zero on the permission-denied
    # entries that caused the leftover in the first place, which would abort
    # the script here under pipefail otherwise.
    leftover_total=$(find "$AI_SANDBOX_DIR" -mindepth 1 2>/dev/null | wc -l) || true
    find "$AI_SANDBOX_DIR" -mindepth 1 2>/dev/null | head -n 50 | sed 's/^/  /' || true
    if [ "${leftover_total:-0}" -gt 50 ]; then
        echo "  ... and $((leftover_total - 50)) more"
    fi
    echo "Finish with: sudo rm -rf $AI_SANDBOX_DIR"
    LEFTOVER="yes"
else
    echo "Removed $AI_SANDBOX_DIR."
fi
echo "Shared assets in $AI_SANDBOX_ROOT/shared and the image were left in place."
echo "The host's Gradle and Maven caches were not touched."
[ -z "${LEFTOVER:-}" ] || exit 1
