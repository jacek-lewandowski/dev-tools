# One sandbox's clone: role, mount targets, skill links, then the sync. Shared
# by 'sync PROJECT_DIR' and by the children of 'sync --all'; never renders.
sync_project_clone() {   # <project dir> <sandbox dir>
    local project=$1 sb=$2 id role=proposals
    id=$(ai_sandbox_project_id "$project")
    if [ -n "$INTEGRATOR" ] && [ "$INTEGRATOR" = "$project" ]; then role=integrator; fi
    if ! lock_take "$sb/.knowledge.lock"; then
        status_context "$sb" "$id" "$role"
        if [ -d "$CLONE/.git" ]; then set_status "skipped: lock busy; another ai-knowledge is syncing this clone"
        else warn "skipped $CLONE: lock busy; another ai-knowledge is syncing it"; fi
        return 0
    fi
    prepare_targets "$sb"
    link_skills_into "$sb"
    sync_clone "$sb" "$id" "$role"
    lock_drop
}

# Undocumented child of 'sync --all': one clone, no render, own hints. The
# parent names the project (the stamp's) and the sandbox; nothing is resolved here.
cmd_sync_clone() {   # <project dir> <sandbox dir>
    load_config
    [ $# -eq 2 ] || die "usage: ai-knowledge _sync-clone <project dir> <sandbox dir>"
    local project=$1 sb=$2
    [ -d "$sb" ] || die "no sandbox directory $sb"
    (cd -- "$project") 2>/dev/null || die "not a directory: $project"
    sync_project_clone "$project" "$sb"
    print_hints "$project"
}

cmd_sync() {
    if ! ai_knowledge_configured; then
        log "knowledge repository not configured (ai-knowledge init <remote-url>); nothing to do"
        return 0
    fi
    load_config
    ensure_ssh_access "$REMOTE"
    [ "${1:-}" != --all ] || { cmd_sync_all; return 0; }
    sync_main_and_render || return 0
    [ $# -gt 0 ] || { print_hints; return 0; }

    local project sb
    project=$(ai_sandbox_project_root "$1") || die "not a directory: $1"
    sb=$(ai_sandbox_dir_for "$project")
    if [ ! -d "$sb" ]; then
        log "no sandbox directory for $project yet; its clone is created by create-ai-sandbox.sh"
        return 0
    fi
    sync_project_clone "$project" "$sb"
    # The integrator just advanced main: render it now rather than on the next sync.
    if [ "$MAIN_PUSHED" = yes ]; then
        sync_main_and_render || true
    fi
    print_hints "$project"
}

# Every stamped sandbox, running or stopped, in parallel. Main is fetched and
# rendered once before the children and, if the fetch worked, once more after
# them, rendering again only when an integrator child advanced it. Children
# never render, so the render is rebuilt by one process at a time. Each child's
# output is captured beside its sandbox, in files named by this run's pid so
# two runs never read each other's, and printed in list order, then one
# table; a child that fails is a row, never the end of the run.
cmd_sync_all() {
    local jobs="${AI_KNOWLEDGE_JOBS:-4}" before after sb project state pids=() running=0
    local -a sbs=() projects=()
    sync_main_and_render || return 0
    before=$(ai_sandbox_host_git "$KNOWLEDGE_MAIN" rev-parse HEAD 2>/dev/null || true)

    while IFS=$'\t' read -r sb project; do
        [ -n "$sb" ] || continue
        sbs+=("$sb"); projects+=("$project")
        rm -f "$sb/.sync-output.$$" "$sb/.sync-exit.$$"
        [ -n "$project" ] || continue                       # unstamped: a row, no child
        [ "$(ai_sandbox_knowledge_state "$sb")" = current ] || continue   # stale: refused at start too
        while [ "$running" -ge "$jobs" ]; do wait -n || true; running=$((running - 1)); done
        (
            # The subshell inherits set -e; without the guard a failing child
            # would end it before its code is recorded.
            rc=0; bash "$0" _sync-clone "$project" "$sb" >"$sb/.sync-output.$$" 2>&1 || rc=$?
            echo "$rc" > "$sb/.sync-exit.$$"
        ) &
        pids+=($!); running=$((running + 1))
    done < <(ai_sandbox_list)
    wait "${pids[@]+"${pids[@]}"}" 2>/dev/null || true

    local i
    for i in "${!sbs[@]}"; do
        sb=${sbs[$i]}
        [ -s "$sb/.sync-output.$$" ] || continue
        printf '\n== %s\n' "$(basename "$sb")"
        cat "$sb/.sync-output.$$"
    done

    # An integrator child may have pushed main; one more fetch shows it.
    if [ "$MAIN_FETCHED" = yes ]; then
        if lock_take "$AI_KNOWLEDGE_ROOT/.lock"; then
            sync_main || true
            after=$(ai_sandbox_host_git "$KNOWLEDGE_MAIN" rev-parse HEAD 2>/dev/null || true)
            [ "$after" = "$before" ] || cmd_render || true
            lock_drop
        else
            warn "another ai-knowledge holds $AI_KNOWLEDGE_ROOT/.lock; the next sync renders again"
        fi
    fi

    printf '\n%-45s %-10s %s\n' sandbox state 'last sync'
    for i in "${!sbs[@]}"; do
        sb=${sbs[$i]}; project=${projects[$i]}
        state=$(ai_sandbox_knowledge_state "$sb")
        # The one repair is a plain create-ai-sandbox.sh run for that sandbox.
        if [ -z "$project" ]; then
            status="not synced: unstamped; recreate it: $(ai_sandbox_recreate_command "$sb")"
        elif [ "$state" != current ]; then
            status="not synced: $state; recreate it: $(ai_sandbox_recreate_command "$sb")"
        elif [ "$(cat "$sb/.sync-exit.$$" 2>/dev/null)" != 0 ]; then
            if [ ! -d "$project" ]; then status="missing project: $project"
            else status="error: exit $(cat "$sb/.sync-exit.$$" 2>/dev/null || echo '?'); see its output above"
            fi
        else
            status=$(status_line "$sb")
        fi
        printf '%-45s %-10s %s\n' "$(basename "$sb")" "$state" "$status"
        rm -f "$sb/.sync-output.$$" "$sb/.sync-exit.$$"
    done
    print_hints
}

# With a project: that sandbox's clone. Without: every sandbox on this host,
# with the knowledge state the start scripts check (current, stale, unstamped).
cmd_status() {
    if ! ai_knowledge_configured; then echo "not configured"; return 0; fi
    load_config
    printf 'remote:      %s\nintegrator:  %s\nmain:        %s\nrender:      %s\n' \
        "$REMOTE" "${INTEGRATOR:-<none>}" \
        "$(ai_sandbox_host_git "$KNOWLEDGE_MAIN" rev-parse --short HEAD 2>/dev/null || echo none)" \
        "$AI_KNOWLEDGE_RENDER"
    # The one clone that commits on main: where the owner edits the rules directly.
    [ -z "$INTEGRATOR" ] || printf 'clone (integrator): %s\n' "$(ai_sandbox_dir_for "$INTEGRATOR")/knowledge"
    local project sb
    if [ $# -gt 0 ]; then
        project=$(ai_sandbox_project_root "$1") || die "not a directory: $1"
        sb=$(ai_sandbox_dir_for "$project")
        printf 'project:     %s\nclone:       %s\nlast sync:   %s\n' \
            "$project" "$sb/knowledge" "$(status_line "$sb")"
        return 0
    fi
    printf '\n%-45s %-10s %s\n' sandbox state 'project; last sync'
    while IFS=$'\t' read -r sb project; do
        [ -n "$sb" ] || continue
        printf '%-45s %-10s %s; %s\n' "$(basename "$sb")" "$(ai_sandbox_knowledge_state "$sb")" \
            "${project:-unknown}" "$(status_line "$sb")"
    done < <(ai_sandbox_list)
}

# A --repo directory that a sandbox can write is not a repository the host may
# run git in (C-GIT); inside a sandbox there is no ~/.ai-sandbox and so no such directory.
require_host_repo() {   # <dir>
    [ -d "$1/.git" ] || die "no git repository at $1"
    ! ai_sandbox_writable_path "$1" || die "$1 is a directory a sandbox can write; the host does not run git in it"
}

# '<branch> <path>' per open proposal file, across every local proposal/*
# branch that main has not absorbed yet. Inside a sandbox the clone is
# ~/knowledge; on the host it is the canonical main checkout unless --repo says.
cmd_proposals() {
    local repo="" b ref
    while [ $# -gt 0 ]; do
        case $1 in
            --repo)   [ $# -ge 2 ] || die "--repo needs a directory"; repo=$2; shift 2 ;;
            --repo=*) repo=${1#*=}; shift ;;
            *)        die "unknown argument: $1" ;;
        esac
    done
    if [ -z "$repo" ]; then
        if [ -d "$HOME/knowledge/.git" ]; then repo="$HOME/knowledge"; else repo="$KNOWLEDGE_MAIN"; fi
    fi
    require_host_repo "$repo"
    while IFS= read -r ref; do
        [ -n "$ref" ] || continue
        b=${ref#refs/heads/}
        ai_sandbox_host_git "$repo" merge-base --is-ancestor "$ref" refs/heads/main 2>/dev/null && continue
        ai_sandbox_host_git "$repo" ls-tree -r --name-only "$ref" -- proposals/ \
            | { grep '\.md$' || true; } | { grep -v '/README\.md$' || true; } | sed "s|^|$b |"
    done < <(ai_sandbox_host_git "$repo" for-each-ref --format='%(refname)' 'refs/heads/proposal/*')
}

# '<name> <path>' per open report file in refs/reports/*; a name with a
# tombstone (refs/reports-closed/<name>) is closed and hidden.
cmd_reports() {
    local repo="" r name
    while [ $# -gt 0 ]; do
        case $1 in
            --repo)   [ $# -ge 2 ] || die "--repo needs a directory"; repo=$2; shift 2 ;;
            --repo=*) repo=${1#*=}; shift ;;
            *)        die "unknown argument: $1" ;;
        esac
    done
    if [ -z "$repo" ]; then
        if [ -d "$HOME/knowledge/.git" ]; then repo="$HOME/knowledge"; else repo="$KNOWLEDGE_MAIN"; fi
    fi
    require_host_repo "$repo"
    while IFS= read -r r; do
        [ -n "$r" ] || continue
        name=${r#refs/reports/}
        ai_sandbox_host_git "$repo" show-ref -q --verify "refs/reports-closed/$name" && continue
        ai_sandbox_host_git "$repo" ls-tree -r --name-only "$r" -- reports/ | { grep '\.md$' || true; } | sed "s|^|$name |"
    done < <(ai_sandbox_host_git "$repo" for-each-ref --format='%(refname)' 'refs/reports/*')
}

# One commit on top of BASE that adds or replaces PATH with the content of
# FILE, built with plumbing so no working tree or index is touched. Prints the
# commit id. Used for proposal branches and for the integrator record on main.
build_commit() {   # <repo> <base ref> <path> <file> <message>
    local repo=$1 base=$2 path=$3 file=$4 msg=$5 idx blob tree identity=()
    ai_sandbox_host_git "$repo" config user.email >/dev/null 2>&1 \
        || identity=(-c user.name=ai-knowledge -c user.email=ai-knowledge@localhost)
    # No RETURN trap: in bash it stays armed in the caller and fires again there.
    idx=$(mktemp); rm -f "$idx"
    if ! { GIT_INDEX_FILE=$idx ai_sandbox_host_git "$repo" read-tree "$base" \
           && blob=$(ai_sandbox_host_git "$repo" hash-object -w "$file") \
           && GIT_INDEX_FILE=$idx ai_sandbox_host_git "$repo" update-index --add --cacheinfo "100644,$blob,$path" \
           && tree=$(GIT_INDEX_FILE=$idx ai_sandbox_host_git "$repo" write-tree); }; then
        rm -f "$idx"; die "cannot build a commit on $base in $repo"
    fi
    rm -f "$idx"
    ai_sandbox_host_git "$repo" "${identity[@]+"${identity[@]}"}" commit-tree "$tree" -p "$base" -m "$msg"
}

# A file becomes one proposal branch, built with plumbing from origin/main so
# no working tree is touched: the migration re-files old proposals with it and
# init files the host's GEMINI.md drift with it.
cmd_propose() {
    local file="" repo="$KNOWLEDGE_MAIN" slug="" project_id="" machine="" project="" push=no
    while [ $# -gt 0 ]; do
        case $1 in
            --repo)       repo=$2; shift 2 ;;
            --slug)       slug=$2; shift 2 ;;
            --project-id) project_id=$2; shift 2 ;;
            --machine)    machine=$2; shift 2 ;;
            --project)    project=$2; shift 2 ;;
            --push)       push=yes; shift ;;
            -*)           die "unknown option: $1" ;;
            *)            file=$1; shift ;;
        esac
    done
    [ -n "$file" ] && [ -f "$file" ] || die "usage: ai-knowledge propose FILE [--repo DIR] [--slug S] [--project-id ID] [--machine M] [--project P] [--push]"
    require_host_repo "$repo"
    ai_sandbox_host_git "$repo" show-ref -q --verify refs/remotes/origin/main || die "$repo has no origin/main"
    command -v python3 >/dev/null 2>&1 || die "python3 is required"
    if [ -z "$slug" ]; then
        slug=$(basename "$file" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//')
        slug=$(ai_sandbox_slug "$slug"); [ -n "$slug" ] || slug=proposal
    fi
    local date path tmp commit branch
    date=$(date +%F); path="proposals/$date-$slug.md"
    tmp=$(mktemp)
    # Frontmatter keys the caller knows (project_id, machine, project) are added
    # when the file lacks them; an existing key wins. Cleanup is explicit: a
    # RETURN trap would stay armed in the caller.
    SRC="$file" DST="$tmp" PID="$project_id" MACHINE="$machine" PROJECT="$project" python3 - <<'PYFM'
import os
text = open(os.environ["SRC"], encoding="utf-8").read()
extra = [(k, os.environ[v]) for k, v in (("project_id", "PID"), ("machine", "MACHINE"), ("project", "PROJECT")) if os.environ.get(v)]
if text.startswith("---\n") and "\n---\n" in text[4:]:
    head, rest = text[4:].split("\n---\n", 1)
    have = {l.split(":", 1)[0].strip() for l in head.splitlines() if ":" in l}
    head = "\n".join([head.rstrip("\n")] + ["%s: %s" % (k, v) for k, v in extra if k not in have])
    text = "---\n" + head + "\n---\n" + rest
elif extra:
    text = "---\n" + "\n".join("%s: %s" % (k, v) for k, v in extra) + "\n---\n\n" + text
open(os.environ["DST"], "w", encoding="utf-8").write(text if text.endswith("\n") else text + "\n")
PYFM
    [ -s "$tmp" ] || { rm -f "$tmp"; die "cannot read $file"; }
    commit=$(build_commit "$repo" refs/remotes/origin/main "$path" "$tmp" "proposal: $slug") || { rm -f "$tmp"; die "cannot build the proposal commit"; }
    rm -f "$tmp"
    branch="proposal/$date-$slug-${commit:0:4}"
    [[ $branch =~ $PROPOSAL_RE ]] || die "slug '$slug' does not make a valid branch name ($branch); use lowercase letters, digits and dashes"
    ai_sandbox_host_git "$repo" update-ref "refs/heads/$branch" "$commit"
    if [ "$push" = yes ]; then
        local rc=0 out
        out=$(git_net -C "$repo" push -q origin "refs/heads/$branch:refs/heads/$branch" 2>&1) || rc=$?
        if [ "$rc" -ne 0 ]; then
            net_failed "$rc" "$out"; warn "created $branch but could not push: $NET_REASON"
            HINT_PUSH+=("$(hint git -C "$repo" push origin "refs/heads/$branch:refs/heads/$branch")"); print_hints
        fi
    fi
    printf '%s\n' "$branch"
}

case "${1:-}" in
    init)      shift; cmd_init "$@" ;;
    sync)      shift; cmd_sync "$@" ;;
    _sync-clone) shift; cmd_sync_clone "$@" ;;
    render)    lock_take "$AI_KNOWLEDGE_ROOT/.lock" || die "another ai-knowledge holds $AI_KNOWLEDGE_ROOT/.lock; try again"
               cmd_render || exit 1 ;;
    status)    shift; cmd_status "$@" ;;
    proposals) shift; cmd_proposals "$@" ;;
    reports)   shift; cmd_reports "$@" ;;
    propose)   shift; load_config
               # Only a push touches the network; a local branch needs no key.
               case " $* " in *" --push "*) ensure_ssh_access "$REMOTE" ;; esac
               cmd_propose "$@" ;;
    -h|--help|help) usage ;;
    '')        usage >&2; exit 2 ;;
    *)         die "unknown command: $1 (try: ai-knowledge --help)" ;;
esac
