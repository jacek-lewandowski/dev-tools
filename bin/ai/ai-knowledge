#!/usr/bin/env bash
# ai-knowledge -- the host side of the shared knowledge repository.
#
# One private git repository holds the global, project-independent knowledge:
# rules/global.md, roles/<name>.md, skills/<name>/ and decisions.md. Every
# sandbox reads a rendered copy of its main branch read-only, and proposes
# changes through its own clone: main checked out, one local branch
# proposal/<date>-<slug>-<hex> per proposal. The integrator sandbox's clone
# carries every open proposal branch and closes them with an ours-merge.
# A process report is a ref in refs/reports/<name>, outside main and refs/heads:
# every clone's is pushed once, only the integrator receives and closes them.
#
# No sandbox has git credentials, so every fetch, merge and push happens here.
# The host never runs git in a sandbox's clone, which the sandbox can write: it
# reads the clone's branches and reports through ai_sandbox_confined_fetch into
# refs/sandbox/<id>/ of its own repository (~/.ai-sandbox/knowledge/main), decides
# there against its own refs/remotes/origin/main, and publishes from there. The clone
# itself is made and updated by sandbox-knowledge-sync, inside the sandbox, from the
# read-only bare origin this script refreshes (<sandbox dir>/knowledge-origin.git),
# and removes a ref only as the status file lists it. A sync never fails a start:
# whatever goes wrong is written to <sandbox dir>/status/knowledge, which
# sandbox-doctor shows. After a sync a running sandbox of the current stamp
# is made to run its command (docker exec).
#
#   ai-knowledge init <remote-url> [--integrator DIR]  configure; seed an empty remote; render
#   ai-knowledge sync [PROJECT_DIR]                     main + render, then publish this project's clone
#   ai-knowledge sync --all                             main + render, then every current sandbox's clone
#                                                       in parallel (AI_KNOWLEDGE_JOBS, default 4)
#   ai-knowledge render                                 render main into the shared store
#   ai-knowledge status [PROJECT_DIR]                   config and the last sync status
#   ai-knowledge proposals [--repo DIR]                 list open proposal files across proposal/* branches
#   ai-knowledge reports [--repo DIR]                   list open report files across refs/reports/* (not branches; never in main)
#   ai-knowledge propose FILE [--repo DIR] [--slug S] [--project-id ID] [--machine M] [--project P] [--push]
#                                                       file FILE as a proposal/* branch from origin/main
set -Eeuo pipefail
HERE=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# set -e ends the script on any unguarded failure, inside functions too (-E);
# without this trap it would do so silently and leave a stale status file behind.
trap 'printf "!! ai-knowledge: unexpected error at line %s\n" "$LINENO" >&2' ERR
# An ssh-agent this process started dies with it, however it ends. The flag is
# a plain variable: children of 'sync --all' inherit the exported agent
# variables but not this, so they never kill the parent's agent.
AGENT_STARTED=""   # pid of the agent this process started, else empty
trap '[ -z "$AGENT_STARTED" ] || SSH_AGENT_PID=$AGENT_STARTED ssh-agent -k >/dev/null 2>&1 || true' EXIT
. "$HERE/ai-sandbox-lib.sh"

KNOWLEDGE_MAIN="$AI_KNOWLEDGE_ROOT/main"
# create-ai-sandbox.sh writes the generated "AI sandbox environment" block here
# instead of into GEMINI.md; the render appends it to rules/global.md.
KNOWLEDGE_ENV_BLOCK="$AI_KNOWLEDGE_ROOT/sandbox-environment.md"
GIT_TIMEOUT="${AI_KNOWLEDGE_GIT_TIMEOUT:-60}"
ENV_BEGIN='<!-- BEGIN dev-tools:ai-sandbox-environment -->'
ENV_END='<!-- END dev-tools:ai-sandbox-environment -->'

log()  { printf '  %s\n' "$*"; }
warn() { printf '!! %s\n' "$*" >&2; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
    sed -n '2,/^set -/{/^set -/d;s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}"
}

# Network git only: a hung remote must not hold up a sandbox start. Nothing
# here can answer a prompt, so git and ssh are told not to ask: an ssh key with
# a passphrase and no agent then fails at once instead of hanging until the
# timeout, and the failure is reported with the command to run by hand.
#
# The host's network git goes through C-GIT's host function, under the time
# limit: 'git_net -C <repository> ...' for a host-owned repository, plain
# 'git_net ...' for a command given a URL alone, which discovers no repository.
git_net() {
    local repo=-
    if [ "${1:-}" = -C ]; then repo=$2; shift 2; fi
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes" \
        AI_SANDBOX_GIT_TIMEOUT="$GIT_TIMEOUT" ai_sandbox_host_git "$repo" "$@"
}
# Every network failure is remembered with its manual equivalent; print_hints
# shows them once, at the end, in the order they have to run.
NET_REASON=""; HINT_FETCH=(); HINT_PUSH=()
# A hint is pasted into a shell, so every word is quoted (paths with spaces).
hint() { local q; q=$(printf '%q ' "$@"); printf '%s' "${q% }"; }
net_failed() {   # <exit code> <captured output>
    local rc=$1 out=$2 line
    if [ "$rc" -eq 124 ]; then
        NET_REASON="timed out after ${GIT_TIMEOUT}s"
    else
        # git's access errors end with generic advice; the fatal:/ssh line says why.
        line=$(printf '%s' "$out" | grep -m1 -E 'fatal:|ssh:|Permission denied|Host key|Could not|Connection|error:' || true)
        [ -n "$line" ] || line=$(printf '%s' "$out" | grep -v '^\s*$' | head -1 || true)
        NET_REASON=${line:-"exit code $rc"}
    fi
}
print_hints() {   # [project dir]
    [ ${#HINT_FETCH[@]} -gt 0 ] || [ ${#HINT_PUSH[@]} -gt 0 ] || return 0
    local c
    warn "network git failed: $NET_REASON"
    warn "This runs without a terminal, so an ssh key that needs a passphrase (and no agent) or a"
    warn "credential prompt cannot be answered here. Run these on the host, in this order:"
    for c in "${HINT_FETCH[@]+"${HINT_FETCH[@]}"}"; do printf '     %s\n' "$c" >&2; done
    if [ ${#HINT_FETCH[@]} -gt 0 ]; then
        printf '     ai-knowledge sync%s\n' "${1:+ $(printf '%q' "$1")}" >&2
    fi
    for c in "${HINT_PUSH[@]+"${HINT_PUSH[@]}"}"; do printf '     %s\n' "$c" >&2; done
}

# Network git cannot answer a passphrase prompt. When the remote refuses the
# key, load it into the user's agent for an hour, or into an agent started for
# this run when a terminal is present; without either, the offline path stays.
# The caller ignores the result: git_net runs either way and reports as before.
ensure_ssh_access() {   # <remote url>
    local url=$1 rest hostpart host user="" port="" rc=0 out target k keys=()
    case $url in
        ssh://*) rest=${url#ssh://}; hostpart=${rest%%/*} ;;
        *://*)   return 0 ;;                       # https, file, git: no key involved
        *:*)     hostpart=${url%%:*}; case $hostpart in */*) return 0 ;; esac ;;   # scp-like user@host:path
        *)       return 0 ;;                       # local path
    esac
    case $hostpart in *@*) user=${hostpart%%@*}; hostpart=${hostpart#*@} ;; esac
    case $hostpart in *:*) port=${hostpart##*:}; hostpart=${hostpart%%:*} ;; esac
    host=$hostpart; target=${user:+$user@}$host

    out=$(git_net ls-remote -q "$url" HEAD 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || return 0
    printf '%s' "$out" | grep -q -E 'Permission denied|publickey' || return 0

    while IFS= read -r k; do
        k=${k/#\~/$HOME}
        [ -f "$k" ] && keys+=("$k")
    done < <(ssh -G ${port:+-p "$port"} "$target" 2>/dev/null | sed -n 's/^identityfile //p' || true)

    # Without a terminal ssh-add would read the passphrase from whatever stdin
    # is and could wait forever on an open pipe; /dev/null makes an encrypted
    # key fail at once (unencrypted keys and an askpass GUI still work).
    add_keys() {
        if [ -t 0 ]; then ssh-add -t 3600 "${keys[@]+"${keys[@]}"}"
        else ssh-add -t 3600 "${keys[@]+"${keys[@]}"}" </dev/null
        fi
    }
    rc=0; ssh-add -l >/dev/null 2>&1 || rc=$?
    if [ -n "${SSH_AUTH_SOCK:-}" ] && [ "$rc" -ne 2 ]; then
        warn "$host refused the ssh key. Adding it to your ssh-agent for one hour (a passphrase prompt may follow)."
        add_keys || { warn "ssh-add failed; continuing offline"; return 0; }
    elif [ -t 0 ]; then
        warn "$host refused the ssh key and no ssh-agent is running. Starting one for this run only;"
        warn "it is removed when ai-knowledge exits (a passphrase prompt may follow)."
        # Capture before eval: a failed substitution evals to nothing and would
        # look like success, and the trap must only ever kill the pid we started.
        local agent_env
        agent_env=$(ssh-agent -s) || { warn "ssh-agent failed to start; continuing offline"; return 0; }
        eval "$agent_env" >/dev/null
        [ -n "${SSH_AGENT_PID:-}" ] || { warn "ssh-agent reported no pid; continuing offline"; return 0; }
        AGENT_STARTED=$SSH_AGENT_PID
        add_keys || { warn "ssh-add failed; continuing offline"; return 0; }
    else
        warn "$host refused the ssh key; no ssh-agent and no terminal to ask for a passphrase. Continuing offline."
        return 0
    fi
    rc=0; git_net ls-remote -q "$url" HEAD >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 0 ] || warn "$host still refuses the key after loading it; continuing offline"
    return 0
}

REMOTE=""; INTEGRATOR=""
read_config() { sed -n "s/^$1=//p" "$AI_KNOWLEDGE_CONFIG" | head -1; }
load_config() {
    ai_knowledge_configured || die "not configured; run: ai-knowledge init <remote-url> [--integrator DIR]"
    REMOTE=$(read_config REMOTE); INTEGRATOR=$(read_config INTEGRATOR)
    [ -n "$REMOTE" ] || die "no REMOTE in $AI_KNOWLEDGE_CONFIG"
}

# The seed sits beside this helper: in the checkout, or installed next to the
# copy in ~/.ai-sandbox/bin by create-ai-sandbox.sh. A recorded dev-tools
# checkout is the fallback for an installation that predates that.
seed_dir() {
    local dev_tools=""
    if [ -d "$HERE/knowledge-seed" ]; then
        printf '%s\n' "$HERE/knowledge-seed"; return 0
    fi
    [ -f "$AI_SANDBOX_ROOT/config" ] && dev_tools=$(sed -n 's/^DEV_TOOLS_DIR=//p' "$AI_SANDBOX_ROOT/config" | head -1)
    if [ -n "$dev_tools" ] && [ -d "$dev_tools/bin/ai/knowledge-seed" ]; then
        printf '%s\n' "$dev_tools/bin/ai/knowledge-seed"
    else
        return 1
    fi
}

# Whatever sits where a checkout belongs is the user's: moved beside it,
# never removed. Prints the new path; nothing when there was nothing to move.
move_aside() {   # <path>
    [ -e "$1" ] || [ -L "$1" ] || return 0
    # empty, it is where the checkout goes
    if [ -d "$1" ] && [ ! -L "$1" ] && [ -z "$(ls -A -- "$1")" ]; then return 0; fi
    local to="$1.not-a-clone.$(date +%Y%m%d%H%M%S)"
    mv "$1" "$to" && printf '%s\n' "$to"
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
    local remote="" integrator="" out rc aside
    while [ $# -gt 0 ]; do
        case $1 in
            --integrator)   [ $# -ge 2 ] || die "--integrator needs a directory"
                            integrator=$(ai_sandbox_project_root "$2") || die "not a directory: $2"; shift 2 ;;
            --integrator=*) integrator=$(ai_sandbox_project_root "${1#*=}") || die "not a directory: ${1#*=}"; shift ;;
            -h|--help)      usage; exit 0 ;;
            -*)             die "unknown option: $1" ;;
            *)              remote=$1; shift ;;
        esac
    done
    [ -n "$remote" ] || die "usage: ai-knowledge init <remote-url> [--integrator DIR]"
    # The record is the stamp's project when the sandbox exists and the
    # directory itself otherwise; say which, because only the sandbox created
    # for exactly that directory (create-ai-sandbox.sh DIR) then takes the role.
    if [ -n "$integrator" ]; then
        if ai_sandbox_stamped "$integrator"; then
            log "integrator: $integrator (sandbox $(basename "$(ai_sandbox_dir_for "$integrator")"))"
        else
            log "integrator: $integrator; no sandbox exists yet for that directory."
            log "  The sandbox create-ai-sandbox.sh creates for exactly that directory takes the role."
        fi
    fi
    command -v git   >/dev/null 2>&1 || die "git is required"
    command -v rsync >/dev/null 2>&1 || die "rsync is required"

    mkdir -p "$AI_KNOWLEDGE_ROOT" "$AI_SANDBOX_ROOT/shared"
    printf 'REMOTE=%s\nINTEGRATOR=%s\n' "$remote" "$integrator" > "$AI_KNOWLEDGE_CONFIG"
    log "config: $AI_KNOWLEDGE_CONFIG"
    REMOTE=$remote; INTEGRATOR=$integrator
    ensure_ssh_access "$REMOTE"

    if [ ! -d "$KNOWLEDGE_MAIN/.git" ]; then
        aside=$(move_aside "$KNOWLEDGE_MAIN")
        [ -z "$aside" ] || warn "$KNOWLEDGE_MAIN was not a git checkout; moved it to $aside"
        rc=0; out=$(git_net clone -q "$remote" "$KNOWLEDGE_MAIN" 2>&1) || rc=$?
        if [ "$rc" -ne 0 ]; then
            rm -f "$AI_KNOWLEDGE_CONFIG"
            net_failed "$rc" "$out"
            warn "cannot clone $remote: $NET_REASON"
            warn "Run on the host, then repeat the init:"
            printf '     %s\n' "$(hint git clone "$remote" "$KNOWLEDGE_MAIN")" >&2
            exit 1
        fi
        log "cloned $remote -> $KNOWLEDGE_MAIN"
    else
        # An existing checkout may be behind: the integrator record and the
        # drift diff below must read the remote's current main.
        rc=0; out=$(git_net -C "$KNOWLEDGE_MAIN" fetch -q --prune origin 2>&1) || rc=$?
        [ "$rc" -eq 0 ] || { net_failed "$rc" "$out"; warn "cannot fetch $remote: $NET_REASON; working from the last fetch"; }
    fi
    # "Empty" means the remote has no main. A bare remote made with plain
    # 'git init' points HEAD at a master that never exists, so a clone of a
    # seeded repository can still have an unborn HEAD; that is not empty.
    local seeded=no
    if ai_sandbox_host_git "$KNOWLEDGE_MAIN" show-ref -q --verify refs/remotes/origin/main; then
        ai_sandbox_host_git "$KNOWLEDGE_MAIN" rev-parse -q --verify HEAD >/dev/null 2>&1 \
            || ai_sandbox_host_git "$KNOWLEDGE_MAIN" checkout -q -B main refs/remotes/origin/main
    elif ! ai_sandbox_host_git "$KNOWLEDGE_MAIN" rev-parse -q --verify HEAD >/dev/null 2>&1; then
        seed_main; seeded=yes
    fi
    ai_sandbox_host_git "$KNOWLEDGE_MAIN" checkout -q main 2>/dev/null \
        || warn "$remote has no 'main' branch; ai-knowledge follows main only"
    record_integrator
    [ "$seeded" = yes ] || offer_gemini_drift
    if lock_take "$AI_KNOWLEDGE_ROOT/.lock"; then
        cmd_render || warn "init finished without a render; run: ai-knowledge render"
        lock_drop
    else
        warn "another ai-knowledge holds $AI_KNOWLEDGE_ROOT/.lock; run: ai-knowledge render"
    fi
    print_hints
    log "done. Sandboxes pick the knowledge up on their next sync (a start, or 'ai-knowledge sync --all'); agents in their next session."
}

# The host's GEMINI.md without the block create-ai-sandbox.sh generates, which
# the render appends again from its own file.
strip_env_block() {   # <src> <dst>
    SRC="$1" DST="$2" ENV_BEGIN="$ENV_BEGIN" ENV_END="$ENV_END" python3 - <<'PYSTRIP'
import os, re
text = open(os.environ["SRC"], encoding="utf-8").read()
pattern = re.compile(r"\n*" + re.escape(os.environ["ENV_BEGIN"]) + r".*?" + re.escape(os.environ["ENV_END"]) + r"\n*", re.DOTALL)
text = pattern.sub("\n", text).strip("\n")
open(os.environ["DST"], "w", encoding="utf-8").write(text + "\n")
PYSTRIP
}

# The repository, not a host's config, says which host integrates: one line in
# README.md on main. A second host asking to integrate is warned, not recorded,
# because two clones committing on main can make it diverge.
record_integrator() {
    local readme existing mine tmp commit rc=0 out idir iid imain hmain
    ai_sandbox_host_git "$KNOWLEDGE_MAIN" show-ref -q --verify refs/remotes/origin/main || return 0
    readme=$(ai_sandbox_host_git "$KNOWLEDGE_MAIN" show refs/remotes/origin/main:README.md 2>/dev/null || true)
    existing=$(printf '%s\n' "$readme" | sed -n 's/^<!-- ai-knowledge integrator: \(.*\) -->$/\1/p' | head -1)
    if [ -z "$INTEGRATOR" ]; then
        [ -z "$existing" ] || log "integrator: $existing (recorded in README.md on main)"
        return 0
    fi
    mine="$(hostname):$INTEGRATOR"
    if [ -z "$existing" ]; then
        # A README commit on origin/main while the integrator's own clone has
        # main ahead would make that main diverge; its push has to come first.
        # The clone is read through the confined fetch, so what is compared is
        # the clone's main as it is now, not as it was at some earlier sync.
        idir=$(ai_sandbox_dir_for "$INTEGRATOR"); iid=$(ai_sandbox_project_id "$INTEGRATOR")
        if [ -d "$idir/knowledge/.git" ]; then
            if ! AI_SANDBOX_GIT_TIMEOUT="$GIT_TIMEOUT" ai_sandbox_confined_fetch "$KNOWLEDGE_MAIN" "refs/sandbox/$iid" "$idir" knowledge 'refs/heads/*' >/dev/null 2>&1; then
                warn "the integrator clone $idir/knowledge could not be read; the record is skipped so that main does not diverge."
                warn "Run: ai-knowledge sync --all, then this init again."
                return 0
            fi
            imain=$(ai_sandbox_host_git "$KNOWLEDGE_MAIN" rev-parse -q --verify "refs/sandbox/$iid/heads/main^{commit}" 2>/dev/null || true)
            hmain=$(ai_sandbox_host_git "$KNOWLEDGE_MAIN" rev-parse -q --verify "refs/remotes/origin/main^{commit}" 2>/dev/null || true)
            if [ -n "$imain" ] && [ "$imain" != "$hmain" ] \
               && ai_sandbox_host_git "$KNOWLEDGE_MAIN" merge-base --is-ancestor "$hmain" "$imain" 2>/dev/null; then
                warn "the integrator clone $idir/knowledge has commits on main that are not on origin/main yet; the record is skipped so that main does not diverge."
                warn "Run: ai-knowledge sync --all (it pushes that main), then this init again."
                return 0
            fi
        fi
        tmp=$(mktemp)
        { printf '%s\n' "$readme"; printf '\n<!-- ai-knowledge integrator: %s -->\n' "$mine"; } > "$tmp"
        commit=$(build_commit "$KNOWLEDGE_MAIN" refs/remotes/origin/main README.md "$tmp" "chore: record the integrator ($mine)")
        rm -f "$tmp"
        out=$(git_net -C "$KNOWLEDGE_MAIN" push -q origin "$commit:refs/heads/main" 2>&1) || rc=$?
        if [ "$rc" -eq 0 ]; then
            ai_sandbox_host_git "$KNOWLEDGE_MAIN" merge -q --ff-only refs/remotes/origin/main >/dev/null 2>&1 || true
            log "recorded the integrator in README.md on main: $mine"
        else
            net_failed "$rc" "$out"; warn "could not record the integrator on main: $NET_REASON (run 'ai-knowledge sync', then init again)"
        fi
    elif [ "$existing" = "$mine" ]; then
        :
    else
        warn "another integrator is already recorded on main: $existing."
        warn "Two clones committing on main can make it diverge; the record is left alone and this host's INTEGRATOR applies locally only."
    fi
}

# A host that had its own GEMINI.md joins a repository that already has rules:
# what differs is shown and, when the user says so, filed as a proposal instead
# of vanishing into the backup file.
offer_gemini_drift() {
    local brain="$HOME/.gemini/GEMINI.md" local_rules remote_rules diff ans ts prop slug branch
    [ -f "$brain" ] && [ ! -L "$brain" ] || return 0
    ai_sandbox_host_git "$KNOWLEDGE_MAIN" show-ref -q --verify refs/remotes/origin/main || return 0
    local_rules=$(mktemp); remote_rules=$(mktemp)
    strip_env_block "$brain" "$local_rules"
    ai_sandbox_host_git "$KNOWLEDGE_MAIN" show refs/remotes/origin/main:rules/global.md > "$remote_rules" 2>/dev/null || : > "$remote_rules"
    diff=$(diff -u --label rules/global.md --label "$(hostname):~/.gemini/GEMINI.md" "$remote_rules" "$local_rules" || true)
    rm -f "$local_rules" "$remote_rules"
    [ -n "$diff" ] || return 0
    warn "this host's ~/.gemini/GEMINI.md differs from rules/global.md on main:"
    printf '%s\n' "$diff" >&2
    ts=$(date +%Y%m%d%H%M%S); slug="gemini-md-$(ai_sandbox_slug "$(hostname)")"
    prop="$AI_KNOWLEDGE_ROOT/gemini-md-drift.$ts.md"
    {
        printf -- '---\nscope: global\nproject: host\ntarget: rules/global.md\n'
        printf 'evidence: at ai-knowledge init on %s, %s had a hand-maintained GEMINI.md that differed from rules/global.md as below.\n---\n\n' "$(date +%F)" "$(hostname)"
        printf '# GEMINI.md drift on %s\n\n```diff\n%s\n```\n' "$(hostname)" "$diff"
    } > "$prop"
    printf 'File this difference as a proposal for the integrator? [y/N] ' >&2
    # A terminal waits for the answer; anything else (a pipe, /dev/null) gets a
    # bounded read, so an inherited silent pipe cannot hold init forever.
    ans=""
    if [ -t 0 ]; then read -r ans || ans=""; else read -r -t 15 ans || ans=""; fi
    case $ans in
        y|Y|yes)
            if branch=$(cmd_propose "$prop" --slug "$slug" --machine "$(hostname)" --project-id host --push); then
                log "filed as $branch"
            else
                warn "could not file the drift; the file is at $prop"
            fi ;;
        *)
            warn "not filed. The old GEMINI.md is kept as a backup beside the new symlink; to file the difference later run:"
            printf '     %s\n' "$(hint ai-knowledge propose "$prop" --slug "$slug" --machine "$(hostname)" --project-id host --push)" >&2 ;;
    esac
}

# An empty remote gets the seed directory plus the host's current global rules
# as rules/global.md, minus the block create-ai-sandbox.sh generates, which the
# render appends again from its own file.
seed_main() {
    local seed src identity=()
    seed=$(seed_dir) || die "cannot find bin/ai/knowledge-seed (is DEV_TOOLS_DIR recorded in $AI_SANDBOX_ROOT/config?)"
    log "seeding the empty repository from $seed"
    rsync -a --exclude=.gitkeep "$seed/" "$KNOWLEDGE_MAIN/"
    mkdir -p "$KNOWLEDGE_MAIN/rules"
    src="$HOME/.gemini/GEMINI.md"
    [ -L "$src" ] && src=$(readlink -f "$src")
    if [ -s "$src" ]; then
        strip_env_block "$src" "$KNOWLEDGE_MAIN/rules/global.md"
        log "rules/global.md taken from ~/.gemini/GEMINI.md"
    else
        printf '# Global rules\n\nRules every agent follows in every project. Keep them generic.\n' \
            > "$KNOWLEDGE_MAIN/rules/global.md"
    fi
    ai_sandbox_host_git "$KNOWLEDGE_MAIN" symbolic-ref HEAD refs/heads/main
    ai_sandbox_host_git "$KNOWLEDGE_MAIN" add -A
    ai_sandbox_host_git "$KNOWLEDGE_MAIN" config user.email >/dev/null 2>&1 \
        || identity=(-c user.name=ai-knowledge -c user.email=ai-knowledge@localhost)
    ai_sandbox_host_git "$KNOWLEDGE_MAIN" "${identity[@]+"${identity[@]}"}" commit -qm "chore: seed the knowledge repository"
    local rc=0 out
    out=$(git_net -C "$KNOWLEDGE_MAIN" push -q -u origin refs/heads/main:refs/heads/main 2>&1) || rc=$?
    if [ "$rc" -eq 0 ]; then
        log "pushed main to $REMOTE"
    else
        net_failed "$rc" "$out"
        warn "seeded locally but could not push to $REMOTE"
        HINT_PUSH+=("$(hint git -C "$KNOWLEDGE_MAIN" push -u origin refs/heads/main:refs/heads/main)")
    fi
}

# ---------------------------------------------------------------------------
# locks
# ---------------------------------------------------------------------------

# Two runs at once (a sandbox start during 'sync --all', two starts) must not
# fetch into the same checkout or rebuild the render under each other. One
# lock covers main and the render, one per clone covers that clone's sync,
# and the two are never held together. The locked region runs in this shell,
# not a subshell: sync_main sets globals its callers read afterwards.
LOCK_FD=""
lock_take() {   # <lock file>; 1 when it stays busy for 300s or cannot be opened
    LOCK_FD=""
    mkdir -p "$(dirname "$1")" 2>/dev/null || return 1
    exec {LOCK_FD}>"$1" || { LOCK_FD=""; return 1; }
    if ! flock -w 300 "$LOCK_FD"; then
        exec {LOCK_FD}>&-; LOCK_FD=""; return 1
    fi
}
lock_drop() {
    [ -z "$LOCK_FD" ] || exec {LOCK_FD}>&-
    LOCK_FD=""
}

# ---------------------------------------------------------------------------
# main checkout and render
# ---------------------------------------------------------------------------

# The canonical checkout only ever fast-forwards; nobody edits it by hand.
# One fetch brings the remote's heads and its reports, each into a namespace of its own
# (C-KNOW): the reports reach the integrator's origin, nothing else reads them here.
FETCH_SPECS=('+refs/heads/*:refs/remotes/origin/*' '+refs/reports/*:refs/origin-reports/*')
MAIN_FETCHED=yes
sync_main() {
    [ -d "$KNOWLEDGE_MAIN/.git" ] || { warn "no checkout at $KNOWLEDGE_MAIN; run: ai-knowledge init"; return 1; }
    local rc=0 out
    out=$(git_net -C "$KNOWLEDGE_MAIN" fetch -q --prune origin "${FETCH_SPECS[@]}" 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        net_failed "$rc" "$out"
        warn "cannot fetch $REMOTE; rendering the last fetched main"
        HINT_FETCH+=("$(hint git -C "$KNOWLEDGE_MAIN" fetch --prune origin "${FETCH_SPECS[@]}")")
        MAIN_FETCHED=no
    fi
    # A manual fetch lands here on the next sync, so the merge runs either way.
    if ai_sandbox_host_git "$KNOWLEDGE_MAIN" show-ref -q --verify refs/remotes/origin/main; then
        ai_sandbox_host_git "$KNOWLEDGE_MAIN" merge -q --ff-only refs/remotes/origin/main >/dev/null 2>&1 \
            || warn "$KNOWLEDGE_MAIN is not a fast-forward of origin/main; it is never edited by hand, so repair it with: $(hint git -C "$KNOWLEDGE_MAIN" reset --hard refs/remotes/origin/main)"
    fi
}

# Main and the render under the main lock. Returns 1 only when there is no
# checkout to sync; a busy lock or a failed render is a warning, and the
# caller syncs the clones anyway.
sync_main_and_render() {
    if ! lock_take "$AI_KNOWLEDGE_ROOT/.lock"; then
        warn "another ai-knowledge holds $AI_KNOWLEDGE_ROOT/.lock; skipping the fetch of main and the render this time"
        return 0
    fi
    local rc=0
    sync_main || rc=1
    [ "$rc" -ne 0 ] || cmd_render || warn "the clones are synced anyway; the next sync renders again"
    lock_drop
    return "$rc"
}

# Under 'cmd_render || ...' errexit is off inside, so every step is checked
# here; the previous render is replaced only once all of them passed.
cmd_render() {
    [ -d "$KNOWLEDGE_MAIN" ] || { warn "no checkout at $KNOWLEDGE_MAIN; run: ai-knowledge init"; return 1; }
    command -v python3 >/dev/null 2>&1 || { warn "python3 is required to render; the previous render is kept"; return 1; }
    command -v rsync   >/dev/null 2>&1 || { warn "rsync is required to render; the previous render is kept"; return 1; }
    mkdir -p "$AI_SANDBOX_ROOT/shared" "$AI_KNOWLEDGE_RENDER" || return 1
    local tmp
    tmp=$(mktemp -d "$AI_SANDBOX_ROOT/shared/.knowledge-render.XXXXXX") || return 1
    if ! python3 - "$KNOWLEDGE_MAIN" "$tmp" "$KNOWLEDGE_ENV_BLOCK" <<'PYEOF'
import os, re, shutil, sys
main, out, env_block = sys.argv[1:4]

def read(path):
    return open(path, encoding="utf-8").read()

def frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.DOTALL)
    if not m:
        return {}, text
    meta = {}
    for line in m.group(1).splitlines():
        if ":" in line and not line.startswith((" ", "\t")):
            key, value = line.split(":", 1)
            meta[key.strip()] = value.strip()
    return meta, m.group(2)

def drop_claude_keys(text):
    m = re.match(r"^(---\n)(.*?)(\n---\n?.*)$", text, re.DOTALL)
    if not m:
        return text
    kept = [l for l in m.group(2).split("\n") if not re.match(r"(tools|model)\s*:", l)]
    return m.group(1) + "\n".join(kept) + m.group(3)

def toml_string(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

# Every directory is a bind-mount source: a missing one would be created by
# Docker, root-owned, so they exist even when empty.
for d in ("claude/agents", "gemini/agents", "antigravity/rules", "codex/agents", "skills"):
    os.makedirs(os.path.join(out, d), exist_ok=True)

parts = []
rules = os.path.join(main, "rules", "global.md")
if os.path.isfile(rules):
    parts.append(read(rules).rstrip("\n"))
if os.path.isfile(env_block):
    parts.append(read(env_block).rstrip("\n"))
with open(os.path.join(out, "GLOBAL.md"), "w", encoding="utf-8") as f:
    f.write("\n\n".join(parts) + "\n")

roles = os.path.join(main, "roles")
if os.path.isdir(roles):
    for fn in sorted(os.listdir(roles)):
        if not fn.endswith(".md") or fn.lower() == "readme.md":
            continue
        text = read(os.path.join(roles, fn))
        if not text.endswith("\n"):
            text += "\n"
        meta, body = frontmatter(text)
        name = meta.get("name") or fn[:-3]
        description = meta.get("description", "")
        body = body.strip("\n") + "\n"
        # Claude Code subagents read the canonical format as is. Gemini CLI
        # gets it without the front matter's tools: and model: keys, because
        # its tool names and model names differ from Claude's.
        with open(os.path.join(out, "claude/agents", name + ".md"), "w", encoding="utf-8") as f:
            f.write(text)
        with open(os.path.join(out, "gemini/agents", name + ".md"), "w", encoding="utf-8") as f:
            f.write(drop_claude_keys(text))
        # Antigravity has no agent types; a model-decision rule with the role's
        # description is the closest thing, for projects that link it in.
        with open(os.path.join(out, "antigravity/rules", name + ".md"), "w", encoding="utf-8") as f:
            f.write("---\ntrigger: model_decision\ndescription: %s\n---\n\n%s" % (description, body))
        # Codex custom agents are TOML; registering them in config.toml is left
        # to the user until the format is verified against an installed Codex.
        with open(os.path.join(out, "codex/agents", name + ".toml"), "w", encoding="utf-8") as f:
            f.write("name = %s\ndescription = %s\ndeveloper_instructions = '''\n%s'''\n"
                    % (toml_string(name), toml_string(description), body.replace("'''", "'' '")))

skills = os.path.join(main, "skills")
if os.path.isdir(skills):
    for fn in sorted(os.listdir(skills)):
        src = os.path.join(skills, fn)
        if os.path.isdir(src) and os.path.isfile(os.path.join(src, "SKILL.md")):
            shutil.copytree(src, os.path.join(out, "skills", fn))
PYEOF
    then
        rm -rf "$tmp"
        warn "rendering $KNOWLEDGE_MAIN failed; the previous render in $AI_KNOWLEDGE_RENDER is kept"
        return 1
    fi
    # In place: GLOBAL.md is bind-mounted as a file into running containers, and
    # a replaced inode would be invisible to them until they restart.
    if ! rsync -a --delete --inplace "$tmp/" "$AI_KNOWLEDGE_RENDER/"; then
        rm -rf "$tmp"
        warn "cannot write $AI_KNOWLEDGE_RENDER; the previous render is kept"
        return 1
    fi
    rm -rf "$tmp"
    wire_host
    log "rendered $KNOWLEDGE_MAIN -> $AI_KNOWLEDGE_RENDER"
}

# The host reads the same knowledge as the sandboxes: its GEMINI.md (and through
# the existing symlink, CLAUDE.md) points at the render, its Claude Code agents
# are the rendered roles, and own skills sit beside the third-party ones.
wire_host() {
    local render="$AI_KNOWLEDGE_RENDER" brain="$HOME/.gemini/GEMINI.md" ts f name
    mkdir -p "$HOME/.gemini" "$HOME/.claude/agents" "$HOME/.agents/skills"
    if [ -e "$brain" ] && [ ! -L "$brain" ]; then
        ts=$(date +%Y%m%d%H%M%S)
        mv "$brain" "$brain.pre-ai-knowledge.$ts"
        log "backed up the hand-maintained ~/.gemini/GEMINI.md -> GEMINI.md.pre-ai-knowledge.$ts"
    fi
    [ "$(readlink "$brain" 2>/dev/null)" = "$render/GLOBAL.md" ] || ln -sfn "$render/GLOBAL.md" "$brain"

    for f in "$HOME"/.claude/agents/*.md; do
        [ -L "$f" ] || continue
        case "$(readlink "$f")" in
            "$render"/claude/agents/*) [ -e "$f" ] || rm -f "$f" ;;
        esac
    done
    for f in "$render"/claude/agents/*.md; do
        [ -f "$f" ] || continue
        ln -sfn "$f" "$HOME/.claude/agents/$(basename "$f")"
    done

    # The one real copy of an own skill goes where the skills CLI keeps
    # third-party ones, and into the shared store every sandbox mounts.
    for f in "$render"/skills/*/; do
        [ -d "$f" ] || continue
        name=$(basename "$f")
        rsync -a --delete "$f" "$HOME/.agents/skills/$name/"
        mkdir -p "$AI_SANDBOX_ROOT/shared/agent-skills/skills"
        rsync -a --delete "$f" "$AI_SANDBOX_ROOT/shared/agent-skills/skills/$name/"
    done
    link_skills_into "$HOME"
}

# Relative symlinks from each tool's skills directory into ~/.agents/skills,
# exactly as the skills CLI lays out third-party skills. BASE is $HOME on the
# host or a sandbox directory, whose .claude/.codex/.gemini are the container's.
# A tool whose directory does not exist is left alone, and so is a real
# directory of the same name: that is a local skill, not ours to replace.
link_skills_into() {
    local base=$1 f name d p
    for f in "$AI_KNOWLEDGE_RENDER"/skills/*/; do
        [ -d "$f" ] || continue
        name=$(basename "$f")
        for d in .claude .codex .gemini; do
            [ -d "$base/$d" ] || continue
            p="$base/$d/skills/$name"
            if [ -d "$p" ] && [ ! -L "$p" ]; then continue; fi
            mkdir -p "$base/$d/skills"
            ln -sfn "../../.agents/skills/$name" "$p"
        done
    done
}

# Every knowledge mount target inside the sandbox directory must exist before
# 'compose up', or Docker creates it root-owned.
prepare_targets() {
    local sb=$1 f
    mkdir -p "$sb/.gemini/agents" "$sb/.claude/agents" "$sb/.codex/agents"
    for f in .gemini/GEMINI.md .claude/CLAUDE.md .codex/AGENTS.md; do
        [ -e "$sb/$f" ] || : > "$sb/$f" 2>/dev/null || true
    done
}

# C-KNOW: the sandbox's origin is rewritten from the host's own refs, never from the
# clone: refs/heads/* from refs/remotes/origin/*, and for the integrator alone
# refs/reports/* from refs/origin-reports/*. Whatever else an origin holds is removed.
# The refs are named in full; origin/HEAD is a pointer and not a branch.
refresh_origin() {   # <sandbox dir> <proposals|integrator>
    local o ref
    local -a specs=('+refs/remotes/origin/*:refs/heads/*' '^refs/remotes/origin/HEAD')
    ai_sandbox_make_origin "$1" || return 1
    o=$(ai_sandbox_origin_dir "$1")
    [ "$2" != integrator ] || specs+=('+refs/origin-reports/*:refs/reports/*')
    ai_sandbox_host_git "$o" fetch -q --prune --no-tags "$KNOWLEDGE_MAIN" "${specs[@]}" || return 1
    while IFS= read -r ref; do
        case $ref in
            refs/heads/*) continue ;;
            refs/reports/*) [ "$2" = integrator ] && continue ;;
        esac
        ai_sandbox_host_git "$o" update-ref -d "$ref" || return 1
    done < <(ai_sandbox_host_git "$o" for-each-ref --format='%(refname)')
}

# ---------------------------------------------------------------------------
# per-sandbox clone
# ---------------------------------------------------------------------------

CLONE=""
MAIN_PUSHED="no"   # set when the integrator sync advanced origin/main
STATUS_NOTE=""     # appended to this clone's status line
STATUS_FILE=""; STATUS_ROLE=""; STATUS_ID=""
STATUS_KEYS=()     # the key=value lines after the role and project id (closed-proposal=...)
STATUS_WORD=""; STATUS_TEXT=""   # the line set_status wrote last, for status_amend
# C-STATUS: the outcome of a sync is the file <sandbox dir>/status/knowledge, which
# the sandbox sees read-only at /run/ai-sandbox/status. Nothing is written below the
# clone. Line 1 is "<time> <ok|warn|refused|offline> <message>", then the keys below;
# the file is replaced whole, so a reader never sees half of it.
# reads-outside: the sandbox-doctor generated by create-ai-sandbox.sh, in the container,
# reads line 1 and role=<proposals|integrator> of this file.
status_context() {   # <sandbox dir> <project id> <proposals|integrator>
    CLONE="$1/knowledge"; STATUS_NOTE=""; STATUS_KEYS=()
    STATUS_FILE="$1/status/knowledge"; STATUS_ID=$2; STATUS_ROLE=$3
}
set_status() {
    local word=warn text="$*" tmp
    case $text in
        ok:*)      word=ok;      text=${text#ok: } ;;
        refused:*) word=refused; text=${text#refused: } ;;
        offline:*) word=offline; text=${text#offline: } ;;
    esac
    STATUS_WORD=$word; STATUS_TEXT=$text
    text="$text${STATUS_NOTE:+; $STATUS_NOTE}"
    mkdir -p "$(dirname "$STATUS_FILE")"
    tmp="$STATUS_FILE.$$"
    {
        printf '%s %s %s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$word" "$(printf '%s' "$text" | tr -d '[:cntrl:]')"
        printf 'role=%s\nproject-id=%s\n' "$STATUS_ROLE" "$STATUS_ID"
        [ ${#STATUS_KEYS[@]} -eq 0 ] || printf '%s\n' "${STATUS_KEYS[@]}" | tr -d '\000-\011\013-\037\177'
    } > "$tmp" && mv -f "$tmp" "$STATUS_FILE"
    log "$text"
}
# The same status with one more note; an ok line becomes a warning.
status_amend() {   # <note>
    local word=$STATUS_WORD text=$STATUS_TEXT
    STATUS_NOTE="${STATUS_NOTE:+$STATUS_NOTE; }$1"
    case $word in
        ok|warn) set_status "$text" ;;
        *)       set_status "$word: $text" ;;
    esac
}
# Line 1 of a sandbox's status file for a person to read: control characters removed,
# "never" when there is none.
status_line() {   # <sandbox dir>
    local line=""
    [ -f "$1/status/knowledge" ] && line=$(head -1 "$1/status/knowledge" | tr -d '[:cntrl:]')
    printf '%s' "${line:-never}"
}

# Closed per the contract: the tip is an ancestor of the host's own refs/remotes/origin/main
# and not on its first-parent chain. An ours-merge puts the tip on the second parent; a
# fresh or emptied branch sits on the chain itself and is "empty": reported, neither
# deleted nor pushed. 0 closed, 1 empty, 2 open (or no origin/main). The tips come from the
# mirror of a sandbox's clone, which lies in the host-owned repository; the main they are
# compared with is the one the host fetched itself.
HOST_MAIN=refs/remotes/origin/main
hostgit() { ai_sandbox_host_git "$KNOWLEDGE_MAIN" "$@"; }
tip_state() {   # <commit>
    hostgit show-ref -q --verify "$HOST_MAIN" || return 2
    hostgit merge-base --is-ancestor "$1" "$HOST_MAIN" 2>/dev/null || return 2
    if grep -qxF "$1" <<<"$(hostgit rev-list --first-parent "$HOST_MAIN")"; then return 1; fi
    return 0
}

PROPOSAL_RE='^proposal/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+-[0-9a-f]{4}$'
# reads-outside: refs/reports/<name> and refs/reports-closed/<name> of the private
# remote, read by the process-report skill and the integrator's knowledge-integrate
# skill. A name is matched after the refs/reports/ prefix.
REPORT_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+-[0-9a-f]{4}$'

# After a sync, a running container whose stamp is current runs the in-sandbox command
# now, so the rules and the closed branches reach the clone without a restart; a
# container that is not running runs it at its start. It runs as the sandbox's own user
# (the image's USER; no -u, so no root), without a terminal and with standard input
# closed, under the time limit; what it prints is shown with control characters removed.
# Failure is a warning on the status line, never the end of the sync.
run_in_sandbox() {   # <sandbox dir>
    local name out rc=0
    name=$(basename "$1")
    [ "$(ai_sandbox_knowledge_state "$1")" = current ] || return 0
    ai_sandbox_container_running "$name" || return 0
    out=$(timeout -k 5 "$GIT_TIMEOUT" docker exec "$name" /usr/local/bin/sandbox-knowledge-sync </dev/null 2>&1) || rc=$?
    [ -z "$out" ] || printf '%s\n' "$out" | tr -d '\000-\011\013-\037\177' | sed 's/^/  /'
    case $rc in
        0) ;;
        124|137) status_amend "the sandbox's own sync failed (timed out after ${GIT_TIMEOUT}s)" ;;
        *)       status_amend "the sandbox's own sync failed (exit $rc)" ;;
    esac
}

# <sandbox dir> <project id> <proposals|integrator>. Nothing here fails the caller: every
# outcome is line 1 of the sandbox's status/knowledge. The host reads the clone only
# through ai_sandbox_confined_fetch, which mirrors its branches, reports and tombstones
# into refs/sandbox/<id>/ of the host-owned repository; everything else (scope, ancestry,
# closing, pushing) is decided there against the host's own refs/remotes/origin/main,
# and the clone is changed only by the sandbox's own command, from the status keys
# written here (closed-proposal=).
#
# Order, for both roles: mirror -> classify every proposal branch as malformed, closed
# (tip_state), empty, or open -> push the open ones -> list the closed ones. The
# integrator also pushes its main when it descends from the host's own and deletes
# closed branches on the remote, under a lease on the tip it saw, so an amendment pushed
# meanwhile survives.
sync_clone() {
    local sb=$1 id=$2 role=$3 out rc net=yes b ref tip remote_tip st mirror mmain hmain listed=" "
    local pushed=0 closed=0 empty=0 pending=0 main_state=current refused="" conflicts="" pushfail=""
    local rpushed=0 rname rref rtip
    status_context "$sb" "$id" "$role"
    mirror="refs/sandbox/$id"
    # First, so that every outcome below leaves the origin as current as the host's refs.
    refresh_origin "$sb" "$role" || STATUS_NOTE="the knowledge origin could not be refreshed"
    [ "$MAIN_FETCHED" = yes ] || net=no

    if [ ! -d "$CLONE/.git" ]; then
        if [ -n "$(ls -A -- "$CLONE" 2>/dev/null)" ]; then
            set_status "~/knowledge is not a clone and the sandbox leaves it alone; move it aside inside the sandbox and restart it"
        else
            set_status "ok: no clone yet; the sandbox makes ~/knowledge from its origin when it starts"
        fi
        run_in_sandbox "$sb"
        return 0
    fi

    rc=0; out=$(AI_SANDBOX_GIT_TIMEOUT="$GIT_TIMEOUT" ai_sandbox_confined_fetch "$KNOWLEDGE_MAIN" "$mirror" "$sb" knowledge \
        'refs/heads/*' 'refs/reports/*' 'refs/reports-closed/*' 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        case $rc in
            124) set_status "the sandbox's clone could not be read: timed out after ${GIT_TIMEOUT}s; nothing was pushed" ;;
            125) set_status "the sandbox's clone could not be read: $(printf '%s' "$out" | grep -m1 -v '^\s*$' || echo 'no container could run'); nothing was pushed" ;;
            *)   set_status "the sandbox's clone could not be read (exit $rc): $(printf '%s' "$out" | grep -m1 -v '^\s*$' || true); nothing was pushed" ;;
        esac
        run_in_sandbox "$sb"
        return 0
    fi

    # Where the clone's main stands against the host's own: ahead or equal is the
    # integrator's to push; behind is the sandbox's command to fast-forward, never
    # pushed (the remote would reject it); anything else has local commits the remote lacks.
    mmain=$(hostgit rev-parse -q --verify "$mirror/heads/main^{commit}" 2>/dev/null || true)
    hmain=$(hostgit rev-parse -q --verify "$HOST_MAIN^{commit}" 2>/dev/null || true)
    if [ -n "$mmain" ] && [ -n "$hmain" ]; then
        if [ "$role" = integrator ] && hostgit merge-base --is-ancestor "$hmain" "$mmain" 2>/dev/null; then :
        elif hostgit merge-base --is-ancestor "$mmain" "$hmain" 2>/dev/null; then main_state=behind
        else main_state=diverged
        fi
    fi
    # An ours-merge keeps proposal files off main; one that got there was
    # merged for real, and the doc says how to re-open it.
    if [ "$role" = integrator ] && [ -n "$mmain" ]; then
        out=$(hostgit ls-tree -r --name-only "$mmain" -- proposals/ 2>/dev/null \
            | { grep '\.md$' || true; } | { grep -v '/README\.md$' || true; })
        if [ -n "$out" ]; then
            warn "main carries proposal files ($(printf '%s' "$out" | tr '\n' ' ')): a proposal branch was merged for real, not with -s ours; every sync reports it as empty and keeps it"
            warn "  finish by hand: remove the file on main with a normal commit and a decisions.md entry, then delete the branch:"
            warn "  git -C ~/knowledge branch -D <branch>   and on the host   git -C ~/.ai-sandbox/knowledge/main push origin :refs/heads/<branch>"
        fi
    fi

    while IFS= read -r ref; do
        [ -n "$ref" ] || continue
        b=${ref#"$mirror/heads/"}
        if ! [[ $b =~ $PROPOSAL_RE ]]; then
            refused="$refused $b (name must be proposal/<date>-<slug>-<4 hex>; rename it: git -C ~/knowledge branch -m $b proposal/<date>-<slug>-<4 hex>)"; continue
        fi
        tip=$(hostgit rev-parse -q --verify "$ref^{commit}" 2>/dev/null || true)
        if [ -z "$tip" ]; then refused="$refused $b (not a commit)"; continue; fi
        tip_state "$tip" && st=0 || st=$?
        case $st in
            0)  STATUS_KEYS+=("closed-proposal=$b $tip"); listed="$listed$b "
                closed=$((closed + 1)); continue ;;
            1)  empty=$((empty + 1)); continue ;;
        esac
        # Fail closed: no merge base (an orphan branch) is refused like a path
        # outside proposals/; without rename detection a file moved out of
        # rules/ shows up as the deleted path it is.
        rc=0; out=$(hostgit diff --name-only --no-renames "$HOST_MAIN...$tip" 2>/dev/null) || rc=$?
        if [ "$rc" -ne 0 ]; then
            refused="$refused $b (no common history with main)"; continue
        fi
        out=$(printf '%s\n' "$out" | grep -v -e '^proposals/' -e '^$' || true)
        if [ -n "$out" ]; then
            refused="$refused $b changes $(printf '%s' "$out" | tr '\n' ' ')"; continue
        fi
        remote_tip=$(hostgit rev-parse -q --verify "refs/remotes/origin/$b^{commit}" 2>/dev/null || true)
        [ "$remote_tip" != "$tip" ] || continue
        if [ -n "$remote_tip" ] && ! hostgit merge-base --is-ancestor "$remote_tip" "$tip"; then
            conflicts="$conflicts $b"; continue
        fi
        if [ "$net" = no ]; then
            HINT_PUSH+=("$(hint git -C "$KNOWLEDGE_MAIN" push origin "$ref:refs/heads/$b")"); pending=$((pending + 1)); continue
        fi
        rc=0; out=$(git_net -C "$KNOWLEDGE_MAIN" push -q origin "$tip:refs/heads/$b" 2>&1) || rc=$?
        if [ "$rc" -ne 0 ]; then
            net_failed "$rc" "$out"; HINT_PUSH+=("$(hint git -C "$KNOWLEDGE_MAIN" push origin "$ref:refs/heads/$b")")
            pushfail="$pushfail $b"; continue
        fi
        pushed=$((pushed + 1))
    done < <(hostgit for-each-ref --format='%(refname)' "$mirror/heads/proposal/")

    local main_note=""
    if [ "$role" = integrator ] && [ "$main_state" = current ] && [ -n "$mmain" ] && [ "$mmain" != "$hmain" ]; then
        if [ "$net" = no ]; then
            HINT_PUSH+=("$(hint git -C "$KNOWLEDGE_MAIN" push origin "$mirror/heads/main:refs/heads/main")"); main_note="main pending"
        else
            rc=0; out=$(git_net -C "$KNOWLEDGE_MAIN" push -q origin "$mmain:refs/heads/main" 2>&1) || rc=$?
            if [ "$rc" -eq 0 ]; then MAIN_PUSHED="yes"; main_note="main pushed"
            else net_failed "$rc" "$out"; HINT_PUSH+=("$(hint git -C "$KNOWLEDGE_MAIN" push origin "$mirror/heads/main:refs/heads/main")"); main_note="main push failed"
            fi
        fi
    fi
    # Remote deletion: only the integrator, only after main is on the remote,
    # only for a tip that is an ancestor of origin/main, and only if the remote
    # still has that tip (the lease). A rejected lease means the proposer pushed
    # an amendment: the proposal is open again, nothing is lost.
    if [ "$role" = integrator ] && [ "$net" = yes ] && [ "$main_note" != "main push failed" ] && [ "$main_note" != "main pending" ]; then
        # Branches the integrator closed in this round became ancestors of
        # origin/main only now that main is pushed; list those too.
        while IFS= read -r ref; do
            [ -n "$ref" ] || continue
            b=${ref#"$mirror/heads/"}
            [[ $b =~ $PROPOSAL_RE ]] || continue
            case $listed in *" $b "*) continue ;; esac
            tip=$(hostgit rev-parse -q --verify "$ref^{commit}" 2>/dev/null || true)
            [ -n "$tip" ] || continue
            tip_state "$tip" && st=0 || st=$?
            [ "$st" -eq 0 ] || continue
            STATUS_KEYS+=("closed-proposal=$b $tip"); listed="$listed$b "; closed=$((closed + 1))
        done < <(hostgit for-each-ref --format='%(refname)' "$mirror/heads/proposal/")
        while IFS= read -r ref; do
            [ -n "$ref" ] || continue
            tip=$(hostgit rev-parse "$ref")
            tip_state "$tip" && st=0 || st=$?
            [ "$st" -eq 0 ] || continue
            b=${ref#refs/remotes/origin/}
            out=$(git_net -C "$KNOWLEDGE_MAIN" push -q "--force-with-lease=refs/heads/$b:$tip" origin ":refs/heads/$b" 2>&1) \
                || case $out in *"stale info"*|*"remote ref does not exist"*) ;; *) warn "cannot delete $b on the remote: $out" ;; esac
        done < <(hostgit for-each-ref --format='%(refname)' 'refs/remotes/origin/proposal/*')
    fi

    # Reports live in refs/reports/<name>, not in refs/heads, so nothing above touches them. The mirror
    # holds the clone's reports and, for the integrator, its tombstones (refs/reports-closed/<name>).
    # A writer's report is pushed once per commit: the host records the push in
    # refs/pushed-reports/<id>/<name> and lists the report as pushed-report= while the clone holds that
    # commit; the clone's command drops it, and the record goes once the mirror no longer holds the
    # report. The integrator keeps its reports until closed: it pushes one the host's own copy of the
    # remote's reports lacks, and deletes a tombstone's report on the remote under a lease on the
    # tombstone's value. closed-report= is written only for a tombstone whose report a fetch of the
    # remote's reports, made after those deletions, no longer finds (N1): a sync that did not reach
    # the remote lists nothing, and the clone keeps both refs.
    local rrec rn
    while IFS= read -r rref; do
        [ -n "$rref" ] || continue
        rn=${rref#"refs/pushed-reports/$id/"}
        hostgit show-ref -q --verify "$mirror/reports/$rn" || hostgit update-ref -d "$rref" || true
    done < <(hostgit for-each-ref --format='%(refname)' "refs/pushed-reports/$id/")
    while IFS= read -r rref; do
        [ -n "$rref" ] || continue
        rname=${rref#"$mirror/reports/"}
        if [ "$role" = integrator ] && hostgit show-ref -q --verify "$mirror/reports-closed/$rname"; then continue; fi
        if ! [[ $rname =~ $REPORT_RE ]]; then
            refused="$refused refs/reports/$rname (name must be refs/reports/<date>-<project>-<4 hex>)"; continue
        fi
        rtip=$(hostgit rev-parse -q --verify "$rref^{commit}" 2>/dev/null || true)
        if [ -z "$rtip" ]; then refused="$refused $rname (not a commit)"; continue; fi
        rc=0; out=$(hostgit diff --name-only --no-renames "$HOST_MAIN...$rtip" 2>/dev/null) || rc=$?
        if [ "$rc" -ne 0 ]; then
            refused="$refused $rname (no common history with main)"; continue
        fi
        out=$(printf '%s\n' "$out" | grep -v -e '^reports/' -e '^$' || true)
        if [ -n "$out" ]; then
            refused="$refused $rname changes $(printf '%s' "$out" | tr '\n' ' ')"; continue
        fi
        rrec="refs/pushed-reports/$id/$rname"
        if [ "$role" = integrator ]; then
            [ "$(hostgit rev-parse -q --verify "refs/origin-reports/$rname" 2>/dev/null || true)" != "$rtip" ] || continue
        elif [ "$(hostgit rev-parse -q --verify "$rrec" 2>/dev/null || true)" = "$rtip" ]; then
            STATUS_KEYS+=("pushed-report=$rname"); continue
        fi
        if [ "$net" = no ]; then
            HINT_PUSH+=("$(hint git -C "$KNOWLEDGE_MAIN" push origin "$rref:refs/reports/$rname")"); pending=$((pending + 1)); continue
        fi
        rc=0; out=$(git_net -C "$KNOWLEDGE_MAIN" push -q origin "$rtip:refs/reports/$rname" 2>&1) || rc=$?
        if [ "$rc" -ne 0 ]; then
            net_failed "$rc" "$out"; HINT_PUSH+=("$(hint git -C "$KNOWLEDGE_MAIN" push origin "$rref:refs/reports/$rname")")
            pushfail="$pushfail $rname"; continue
        fi
        rpushed=$((rpushed + 1))
        if [ "$role" != integrator ]; then
            hostgit update-ref "$rrec" "$rtip" || true
            STATUS_KEYS+=("pushed-report=$rname")
        fi
    done < <(hostgit for-each-ref --format='%(refname)' "$mirror/reports/")

    if [ "$role" = integrator ] && [ "$net" = yes ]; then
        local -a rtombs=()
        local rfail=" " rstale=" "
        while IFS= read -r rref; do
            [ -n "$rref" ] || continue
            rname=${rref#"$mirror/reports-closed/"}
            [[ $rname =~ $REPORT_RE ]] || continue
            rtip=$(hostgit rev-parse -q --verify "$rref" 2>/dev/null || true)
            [ -n "$rtip" ] || continue
            rtombs+=("$rname")
            rc=0; out=$(git_net -C "$KNOWLEDGE_MAIN" push -q "--force-with-lease=refs/reports/$rname:$rtip" origin ":refs/reports/$rname" 2>&1) || rc=$?
            [ "$rc" -ne 0 ] || continue
            case $out in
                *"remote ref does not exist"*) ;;
                *"stale info"*) rstale="$rstale$rname " ;;
                *) net_failed "$rc" "$out"; warn "cannot delete report $rname on the remote: $out"; rfail="$rfail$rname " ;;
            esac
        done < <(hostgit for-each-ref --format='%(refname)' "$mirror/reports-closed/")
        # git answers "stale info" for a report the remote no longer has too, so only this fetch tells
        # a report that moved from one that is gone.
        rc=0; out=$(git_net -C "$KNOWLEDGE_MAIN" fetch -q --prune origin '+refs/reports/*:refs/origin-reports/*' 2>&1) || rc=$?
        if [ "$rc" -eq 0 ]; then
            for rname in ${rtombs[@]+"${rtombs[@]}"}; do
                case $rfail in *" $rname "*) continue ;; esac
                if hostgit show-ref -q --verify "refs/origin-reports/$rname"; then
                    case $rstale in *" $rname "*) STATUS_NOTE="${STATUS_NOTE:+$STATUS_NOTE; }report $rname not closed: the remote ref moved since it was fetched" ;; esac
                    continue
                fi
                STATUS_KEYS+=("closed-report=$rname")
            done
        else
            net_failed "$rc" "$out"
            HINT_FETCH+=("$(hint git -C "$KNOWLEDGE_MAIN" fetch --prune origin '+refs/reports/*:refs/origin-reports/*')")
        fi
        # The origin carries the remote's reports as this sync left them.
        refresh_origin "$sb" "$role" || STATUS_NOTE="${STATUS_NOTE:+$STATUS_NOTE; }the knowledge origin could not be refreshed"
    fi

    if [ -n "$refused" ]; then
        set_status "refused: not pushed:$refused; fix or delete those branches"
    elif [ -n "$conflicts" ]; then
        set_status "conflict: remote has commits these branches lack:$conflicts; merge origin/<branch> inside the sandbox"
    elif [ "$main_state" = diverged ]; then
        # The integrator's own commits on main are wanted: merged, never reset
        # away. A proposing clone's belong on a proposal branch first.
        if [ "$role" = integrator ]; then
            set_status "diverged: main has local commits and origin/main moved on; merge it inside the sandbox: git -C ~/knowledge merge origin/main (the next sync pushes the result); pushed $pushed"
        else
            set_status "diverged: main has local commits (only the integrator commits on main); keep them on a proposal branch first: git -C ~/knowledge branch proposal/tmp-<slug> main, then git -C ~/knowledge reset --hard origin/main, then rename the branch as the propose-rule skill does; pushed $pushed"
        fi
    elif [ "$net" = no ]; then
        set_status "offline: cannot reach $REMOTE; pending push: $pending branch(es)${main_note:+, $main_note} (see the commands below)"
    elif [ -n "$pushfail" ] || [ "$main_note" = "main push failed" ]; then
        set_status "push failed: $NET_REASON (${main_note:+$main_note}${pushfail:+; branches:$pushfail})"
    else
        set_status "ok: main current${main_note:+, $main_note}; pushed $pushed; closed $closed$([ "$empty" -eq 0 ] || printf '; empty %d' "$empty")$([ "$rpushed" -eq 0 ] || printf '; reports pushed %d' "$rpushed")"
    fi
    run_in_sandbox "$sb"
}

