#!/usr/bin/env bash
# Reclaim space that migration deliberately left alone: per-sandbox duplicates
# of assets that now live once under shared/, shared stores that no sandbox
# mounts any more, build-cache trash leftovers a reset could not delete, and
# images from the old per-project naming scheme, and installed revisions that are no
# longer current, with the partial exports an interrupted install left behind.
#
# Migration never deletes. This does -- so it lists everything first and removes
# nothing without confirmation.
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ai-sandbox-lib.sh"
ai_sandbox_refuse_writable_self "${BASH_SOURCE[0]}" || exit 3

assume_yes="no"
[ "${1:-}" = "--yes" ] && assume_yes="yes"

targets=()
for dir in "$AI_SANDBOX_ROOT"/*-agent; do
    [ -d "$dir" ] || continue
    while IFS='|' read -r sub _ctr sb; do
        [ -n "$sub" ] && [ -n "$sb" ] || continue
        src="$dir/$sb"
        dst="$AI_SANDBOX_ROOT/shared/$sub"
        # Only ever a duplicate: the shared copy must already be populated.
        [ -d "$src" ] && [ -n "$(ls -A "$src" 2>/dev/null)" ] || continue
        [ -d "$dst" ] && [ -n "$(ls -A "$dst" 2>/dev/null)" ] || continue
        targets+=("$src")
    done < <(ai_sandbox_shared_mounts)
done

# Stores that left the shared table -- ~/.cache, ~/.npm and the IDE's CachedData
# were shared once and are per sandbox now -- are never mounted again by a
# compose file that create-ai-sandbox.sh has rewritten. A sandbox whose compose
# file predates the change still binds them read-write, and only a re-run of
# create-ai-sandbox.sh rewrites it: removing the store from under such a sandbox
# hands it a root-owned ~/.cache or ~/.npm on its next start, so those stay.
stale=(); held=()
for d in "$AI_SANDBOX_ROOT"/shared/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    ai_sandbox_shared_mounts | cut -d'|' -f1 | grep -qx "$(basename "$d")" && continue
    if grep -lsF -e "$d:" -e "$d/" "$AI_SANDBOX_ROOT"/*-agent/docker-compose.yml >/dev/null 2>&1; then
        held+=("$d"); continue
    fi
    stale+=("$d")
done

# Build-caches/.trash leftovers (D4): ai_sandbox_caches_reset renames a layer
# aside and deletes it there, but a root-owned entry left by the container
# user's sudo can survive that delete and only warns. Orphan volumes are not
# collected here (D8).
trash=()
for dir in "$AI_SANDBOX_ROOT"/*-agent; do
    [ -d "$dir/build-caches/.trash" ] || continue
    for t in "$dir"/build-caches/.trash/*; do
        [ -e "$t" ] || continue
        trash+=("$t")
    done
done

# Installed revisions (ai-sandbox-install): every rev/<commit> but the current one, and
# the partial exports. A running container holds the revision it started with and what it
# mounts is not read from here, so none is removed while a sandbox container runs.
old_revs=(); partial_revs=(); revs_kept=no
current_rev=$(readlink "$AI_SANDBOX_INSTALLED/current" 2>/dev/null || true)
for r in "$AI_SANDBOX_INSTALLED"/rev/*; do
    [ -d "$r" ] || continue
    [ "rev/$(basename "$r")" != "$current_rev" ] || continue
    old_revs+=("$r")
done
for r in "$AI_SANDBOX_INSTALLED"/rev/.partial-*; do
    [ -d "$r" ] && partial_revs+=("$r")
done
if [ $(( ${#old_revs[@]} + ${#partial_revs[@]} )) -gt 0 ] && command -v docker >/dev/null 2>&1; then
    # The listing is read whole before grep sees it: 'docker ps | grep -q' under pipefail fails
    # with SIGPIPE when grep stops at the first match, and that would read as "none running".
    running=$(docker ps --format '{{.Names}}' 2>/dev/null || true)
    if grep -q -- '-agent$' <<<"$running"; then revs_kept=yes; fi
fi

legacy_images=()
if command -v docker >/dev/null 2>&1; then
    while IFS= read -r img; do
        [ -n "$img" ] && legacy_images+=("$img")
    done < <(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep '^ai-sandbox-' || true)
fi

print_revs_kept() {
    [ "$revs_kept" = yes ] || return 0
    echo "Kept: installed revisions that are no longer current, and partial exports (a sandbox is running; stop the running sandboxes first):"
    for t in "${old_revs[@]+"${old_revs[@]}"}" "${partial_revs[@]+"${partial_revs[@]}"}"; do
        printf '  %-6s %s\n' "$(du -sh "$t" 2>/dev/null | cut -f1)" "$t"
    done
}
revs_listed=$(( ${#old_revs[@]} + ${#partial_revs[@]} ))
[ "$revs_kept" = no ] || revs_listed=0
if [ "${#targets[@]}" -eq 0 ] && [ "${#stale[@]}" -eq 0 ] && [ "${#trash[@]}" -eq 0 ] && [ "${#legacy_images[@]}" -eq 0 ] \
   && [ "$revs_listed" -eq 0 ]; then
    print_revs_kept
    echo "Nothing to reclaim."
    exit 0
fi

if [ "${#targets[@]}" -gt 0 ]; then
    echo "Duplicated directories (a populated shared copy already exists):"
    for t in "${targets[@]}"; do
        printf '  %-6s %s\n' "$(du -sh "$t" 2>/dev/null | cut -f1)" "$t"
    done
fi
if [ "${#stale[@]}" -gt 0 ]; then
    echo "Shared stores no sandbox mounts any more:"
    for t in "${stale[@]}"; do
        printf '  %-6s %s\n' "$(du -sh "$t" 2>/dev/null | cut -f1)" "$t"
    done
fi
if [ "${#held[@]}" -gt 0 ]; then
    echo "Kept: shared stores an older compose file still mounts (re-run create-ai-sandbox.sh on those sandboxes first):"
    for t in "${held[@]}"; do
        printf '  %-6s %s  <- %s\n' "$(du -sh "$t" 2>/dev/null | cut -f1)" "$t" \
            "$(grep -lsF -e "$t:" -e "$t/" "$AI_SANDBOX_ROOT"/*-agent/docker-compose.yml | xargs -n1 dirname | xargs -n1 basename | paste -sd' ')"
    done
fi
if [ "${#trash[@]}" -gt 0 ]; then
    echo "Build-cache trash leftovers (not yet deleted by a reset):"
    for t in "${trash[@]}"; do
        printf '  %-6s %s\n' "$(du -sh "$t" 2>/dev/null | cut -f1)" "$t"
    done
fi
if [ "${#legacy_images[@]}" -gt 0 ]; then
    echo "Images from the old per-project naming scheme:"
    printf '  %s\n' "${legacy_images[@]}"
fi
if [ "$revs_listed" -gt 0 ]; then
    echo "Installed revisions that are no longer current, and partial exports:"
    for t in "${old_revs[@]+"${old_revs[@]}"}" "${partial_revs[@]+"${partial_revs[@]}"}"; do
        printf '  %-6s %s\n' "$(du -sh "$t" 2>/dev/null | cut -f1)" "$t"
    done
fi
print_revs_kept

if [ "$assume_yes" != "yes" ]; then
    printf 'Remove the duplicates, stale stores, trash leftovers, images and old revisions listed above (kept stores and revisions stay)? [y/N] '
    read -r reply || reply=n
    case "$reply" in y|Y) ;; *) echo "Cancelled. Nothing was removed."; exit 0 ;; esac
fi

for t in "${targets[@]+"${targets[@]}"}"; do
    rm -rf "$t"
    mkdir -p "$t"      # stays a valid bind-mount source
done
for t in "${stale[@]+"${stale[@]}"}"; do
    rm -rf "$t"
done
for t in "${trash[@]+"${trash[@]}"}"; do
    rm -rf "$t" 2>/dev/null || echo "  could not remove $t; finish with: sudo rm -rf $t" >&2
done
if [ "$revs_listed" -gt 0 ]; then
    for t in "${old_revs[@]+"${old_revs[@]}"}" "${partial_revs[@]+"${partial_revs[@]}"}"; do
        # revisions are read-only directories
        chmod -R u+w -- "$t" 2>/dev/null || true
        rm -rf -- "$t" || echo "  could not remove $t" >&2
    done
fi
for img in "${legacy_images[@]+"${legacy_images[@]}"}"; do
    docker rmi "$img" >/dev/null 2>&1 || echo "  could not remove $img (still in use?)" >&2
done
echo "Reclaimed."
