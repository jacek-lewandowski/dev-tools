#!/usr/bin/env bash
# Marks this Claude Code session's handover ready so the status line shows it
# (tools/context_statusline/mark.py). Usage: handover-ready <handover-path> | --clear
# The session is CLAUDE_CODE_SESSION_ID; no caller directory is used.
# Finds tools/ beside the revision it runs from (bin/ai/../../tools).
# Exit: 0 done, 2 no tools directory or no session found.
set -euo pipefail

self=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# The refusal needs the lib beside this script; the image's copy has none.
if [ -f "$self/ai-sandbox-lib.sh" ]; then
    . "$self/ai-sandbox-lib.sh"
    ai_sandbox_refuse_writable_self "${BASH_SOURCE[0]}" || exit 3
fi
if [ -d "$self/../../tools/context_statusline" ]; then tools="$self/../../tools"
else echo "handover-ready: no 'tools' directory beside this script (run it from an installed revision)" >&2; exit 2
fi
cd "$(dirname "$tools")"
# -I leaves the working directory off sys.path, so the directory holding tools/ is put there here.
exec python3 -I -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from tools.context_statusline.mark import main; sys.exit(main(sys.argv[1:]))' "$PWD" "$@"
