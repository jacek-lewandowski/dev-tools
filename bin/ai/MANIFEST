entry bin/ai/ai-sandbox-restart
entry bin/ai/ai-sandbox-rm
entry bin/ai/ai-sandbox-stop
entry bin/ai/ai-knowledge
entry bin/ai/context-statusline
entry bin/ai/handover-ready
entry bin/ai/update-antigravity-ide.sh
entry tests/ai-sandbox/run-tests.sh
entry verify-ai-sandbox-on-host.sh

source bin/ai/ai-sandbox-lib.sh
source bin/ai/create.d/compose.sh
source bin/ai/create.d/devices.sh
source bin/ai/create.d/display.sh
source bin/ai/create.d/image.sh
source bin/ai/create.d/install.sh
source bin/ai/create.d/options.sh
source bin/ai/create.d/project.sh
source bin/ai/create.d/resources.sh
