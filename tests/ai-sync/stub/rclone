#!/usr/bin/env bash
# Records every invocation and answers the few queries ai-sync makes.
set -euo pipefail
printf '%s\n' "$*" >> "${RCLONE_STUB_LOG:-/dev/null}"
case "$1" in
    version)     echo "rclone v0.0-stub"; exit 0 ;;
    listremotes) echo "gdrive:"; exit 0 ;;
    lsf)
        # The remote index; RCLONE_STUB_INDEX unset means the remote does not exist.
        [ -n "${RCLONE_STUB_INDEX:-}" ] || { echo "directory not found" >&2; exit 3; }
        cat "$RCLONE_STUB_INDEX"; exit 0 ;;
esac
exit 0
