#!/usr/bin/env python3
import sys
import os
import shutil
import fnmatch

args = sys.argv[1:]
excludes = []
ignore_existing = False
sources = []

i = 0
while i < len(args):
    arg = args[i]
    if arg == '--exclude':
        i += 1
        excludes.append(args[i])
    elif arg.startswith('--exclude='):
        excludes.append(arg.split('=', 1)[1])
    elif arg == '--ignore-existing':
        ignore_existing = True
    elif arg.startswith('-') and not os.path.exists(arg):
        pass
    else:
        sources.append(arg)
    i += 1

if len(sources) >= 2:
    dest = sources.pop()
else:
    sys.exit(0)

def should_exclude(relpath):
    for pat in excludes:
        if fnmatch.fnmatch(relpath, pat) or fnmatch.fnmatch(os.path.basename(relpath), pat):
            return True
        if pat.endswith('/') and fnmatch.fnmatch(relpath + '/', pat):
            return True
        if pat in relpath.split(os.sep):
            return True
    return False

for src in sources:
    if not os.path.exists(src):
        continue
    if os.path.isdir(src):
        src_trailing = src.endswith('/')
        os.makedirs(dest, exist_ok=True)
        target_base = dest if src_trailing else os.path.join(dest, os.path.basename(src))
        for root, dirs, files in os.walk(src):
            rel = os.path.relpath(root, src)
            if rel != '.' and should_exclude(rel):
                dirs[:] = []
                continue
            cur_target = target_base if rel == '.' else os.path.join(target_base, rel)
            os.makedirs(cur_target, exist_ok=True)
            # rsync -a copies a symlink as a symlink, whether it points at a
            # file, a directory or nothing at all. os.walk lists a link to a
            # directory under dirs and never descends it, so lift those out
            # here and let the file loop below recreate them.
            linked = [d for d in dirs if os.path.islink(os.path.join(root, d))]
            dirs[:] = [d for d in dirs if d not in linked]
            files = files + linked
            for f in files:
                f_rel = f if rel == '.' else os.path.join(rel, f)
                if should_exclude(f_rel):
                    continue
                dst_file = os.path.join(cur_target, f)
                if ignore_existing and os.path.exists(dst_file):
                    continue
                try:
                    if os.path.lexists(dst_file):
                        os.remove(dst_file)
                    shutil.copy2(os.path.join(root, f), dst_file, follow_symlinks=False)
                except Exception:
                    pass
    else:
        target_dir = dest if (os.path.isdir(dest) or dest.endswith('/')) else (os.path.dirname(dest) or '.')
        os.makedirs(target_dir, exist_ok=True)
        dst_file = os.path.join(dest, os.path.basename(src)) if os.path.isdir(dest) else dest
        if not (ignore_existing and os.path.exists(dst_file)):
            try:
                shutil.copy2(src, dst_file)
            except Exception:
                pass
