#!/usr/bin/env bash
# Not on PATH by default: a test symlinks it as 'timeout' into a directory it
# puts first on PATH for one run, so only that run's git_net calls see it.
# LEASE_STUB_MODE=fetch-fail makes every 'timeout ... git ... fetch ... origin ...' (the
# host's fetch from the remote) exit 128 without a word, the way a git that dies before
# printing anything does; the fetch from a sandbox's clone names no 'origin' and runs.
# LEASE_STUB_MODE=amend plays the proposer who amends at the worst moment: when
# the command deletes a proposal branch on the remote (a ':refs/heads/<b>'
# refspec), it first pushes one more commit to <b> from the clone named by
# LEASE_STUB_CLONE to the remote named by LEASE_STUB_REMOTE (the proposer's own push, made
# here because a sandbox has no credentials), directly and not through timeout, and then runs the real
# command; a leased deletion is then rejected with "stale info", a plain one
# wipes the amendment. Everything else, and every other mode, runs the real
# timeout.
case "${LEASE_STUB_MODE:-}" in
    fetch-fail)
        f=""; o=""
        for a in "$@"; do [ "$a" != fetch ] || f=1; [ "$a" != origin ] || o=1; done
        [ -z "$f" ] || [ -z "$o" ] || exit 128 ;;
    amend)
        for a in "$@"; do
            case $a in
                :refs/heads/proposal/*)
                    b=${a#:refs/heads/}
                    f=$(git -C "$LEASE_STUB_CLONE" ls-tree -r --name-only "$b" -- proposals/ | grep -v '/README\.md$' | head -1)
                    git -C "$LEASE_STUB_CLONE" checkout -q "$b" \
                        && echo "amended during the integrator's sync" >> "$LEASE_STUB_CLONE/$f" \
                        && git -C "$LEASE_STUB_CLONE" commit -qam "amend $b" \
                        && git -C "$LEASE_STUB_CLONE" push -q "$LEASE_STUB_REMOTE" "$b:refs/heads/$b" >/dev/null 2>&1
                    git -C "$LEASE_STUB_CLONE" checkout -q main ;;
            esac
        done ;;
esac
exec /usr/bin/timeout "$@"
